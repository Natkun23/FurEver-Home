@model FurEver_Home.Models.AdoptionApplication
@{
    ViewBag.Title = "Set Pickup Details - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
      * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    min-height: 100vh;
    padding: 40px 20px;
    position: relative;
    overflow-x: hidden;
}

body::before {
    content: '';
    position: fixed;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 217, 61, 0.1) 0%, transparent 70%);
    animation: rotate 30s linear infinite;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
}

@@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
}

.pickup-card {
    background: white;
    border-radius: 28px;
    box-shadow: 0 25px 70px rgba(0,0,0,0.15), 0 10px 25px rgba(0,0,0,0.1);
    overflow: hidden;
    position: relative;
    animation: slideIn 0.6s ease-out;
    will-change: transform, opacity;
}

@@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.pickup-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, #FFD93D, #F6C90E, #3FA9F5, #2E8BC0);
    background-size: 200% 100%;
    animation: shimmer 3s linear infinite;
    will-change: background-position;
}

@@keyframes shimmer {
    0% { background-position: 0% 0%; }
    100% { background-position: 200% 0%; }
}

.header {
    background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
    padding: 50px 40px;
    color: #2E8BC0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.header::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
    animation: pulse 4s ease-in-out infinite;
}

@@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 0.8; }
}

.header i {
    font-size: 4.5em;
    margin-bottom: 20px;
    display: block;
    position: relative;
    animation: bounce 2s ease-in-out infinite;
    filter: drop-shadow(0 5px 15px rgba(46, 139, 192, 0.3));
    will-change: transform;
}

@@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.header h1 {
    font-size: 2.5em;
    margin-bottom: 10px;
    font-weight: 900;
    position: relative;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
    letter-spacing: -0.5px;
}

.header p {
    font-size: 1.2em;
    opacity: 0.95;
    position: relative;
    font-weight: 500;
}

.content {
    padding: 45px;
    background: linear-gradient(to bottom, #ffffff 0%, #fafbfc 100%);
}

.adopter-info {
    background: linear-gradient(135deg, #E8F4FC 0%, #d4e9f7 100%);
    padding: 30px;
    border-radius: 20px;
    margin-bottom: 35px;
    border-left: 5px solid #3FA9F5;
    box-shadow: 0 8px 20px rgba(63, 169, 245, 0.15);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
}

.adopter-info::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.adopter-info:hover::before {
    opacity: 1;
}

.adopter-info:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(63, 169, 245, 0.25);
}

.adopter-info h3 {
    color: #1e40af;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.3em;
    position: relative;
}

.adopter-info h3 i {
    font-size: 1.2em;
    filter: drop-shadow(0 2px 4px rgba(30, 64, 175, 0.2));
}

.adopter-info p {
    color: #334155;
    margin-bottom: 10px;
    font-size: 1.05em;
    position: relative;
    padding-left: 20px;
}

.adopter-info p::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #3FA9F5;
    font-weight: bold;
}

.adopter-info strong {
    color: #2E8BC0;
    font-weight: 700;
}

.pet-summary {
    display: flex;
    gap: 25px;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    padding: 25px;
    border-radius: 20px;
    margin-bottom: 35px;
    align-items: center;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    border: 2px solid #e2e8f0;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: transform;
}

.pet-summary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transition: left 0.5s ease;
}

.pet-summary:hover::before {
    left: 100%;
}

.pet-summary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    border-color: #3FA9F5;
}

.pet-thumb {
    width: 110px;
    height: 110px;
    border-radius: 20px;
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    border: 4px solid white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
}

.pet-summary:hover .pet-thumb {
    transform: scale(1.05) rotate(2deg);
    box-shadow: 0 12px 30px rgba(0,0,0,0.2);
}

.pet-details h4 {
    color: #2E8BC0;
    font-size: 1.5em;
    margin-bottom: 8px;
    font-weight: 800;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.05);
}

.pet-details p {
    color: #64748b;
    font-size: 1em;
    font-weight: 500;
}

.form-section {
    margin-bottom: 35px;
}

.section-title {
    font-size: 1.4em;
    color: #2E8BC0;
    font-weight: 800;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 3px solid #E8F4FC;
    position: relative;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #3FA9F5, #2E8BC0);
    border-radius: 3px;
}

.section-title i {
    filter: drop-shadow(0 2px 4px rgba(46, 139, 192, 0.3));
}

.form-group {
    margin-bottom: 28px;
    position: relative;
}

.form-group label {
    display: block;
    color: #334155;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 15px;
    position: relative;
    padding-left: 12px;
}

.form-group label::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 18px;
    background: linear-gradient(135deg, #3FA9F5, #2E8BC0);
    border-radius: 2px;
}

.required {
    color: #ef4444;
    margin-left: 3px;
    font-weight: 900;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 16px 18px;
    border: 2px solid #e2e8f0;
    border-radius: 15px;
    font-size: 15px;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
    outline: none;
    background: #f8fafc;
    font-family: inherit;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    will-change: transform;
}

.form-group input:hover,
.form-group textarea:hover {
    border-color: #cbd5e1;
    background: #ffffff;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #3FA9F5;
    background: white;
    box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.15), inset 0 2px 4px rgba(0,0,0,0.02);
    transform: translateY(-1px);
}

.form-group textarea {
    min-height: 130px;
    resize: vertical;
}

.help-text {
    color: #64748b;
    font-size: 0.9em;
    margin-top: 10px;
    padding-left: 12px;
    font-style: italic;
}

.info-banner {
    background: linear-gradient(135deg, #FFF9E6 0%, #fff4d4 100%);
    border-left: 5px solid #FFD93D;
    padding: 25px;
    border-radius: 18px;
    margin-bottom: 35px;
    color: #92400e;
    box-shadow: 0 8px 20px rgba(255, 217, 61, 0.15);
    position: relative;
    overflow: hidden;
}

.info-banner::before {
    content: '⚠';
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 4em;
    opacity: 0.08;
    transform: rotate(15deg);
}

.info-banner h4 {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.2em;
    position: relative;
    font-weight: 800;
}

.info-banner h4 i {
    filter: drop-shadow(0 2px 4px rgba(146, 64, 14, 0.2));
}

.info-banner ul {
    margin-left: 20px;
    line-height: 1.9;
    position: relative;
}

.info-banner ul li {
    margin-bottom: 6px;
    position: relative;
    padding-left: 8px;
}

.action-buttons {
    display: flex;
    gap: 18px;
    margin-top: 35px;
}

.btn {
    flex: 1;
    padding: 18px;
    border: none;
    border-radius: 15px;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
    will-change: transform;
}

.btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.4s ease, height 0.4s ease;
}

.btn:hover::before {
    width: 300px;
    height: 300px;
}

.btn i {
    position: relative;
    z-index: 1;
}

.btn span {
    position: relative;
    z-index: 1;
}

.btn-submit {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
}

.btn-submit:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(16, 185, 129, 0.4);
}

.btn-submit:active {
    transform: translateY(-1px);
}

.btn-back {
    background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
    color: #334155;
    box-shadow: 0 8px 20px rgba(51, 65, 85, 0.1);
}

.btn-back:hover {
    background: linear-gradient(135deg, #cbd5e1 0%, #b4bcc7 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(51, 65, 85, 0.15);
}

/* Pickup Confirmation Modal Styles */
.pickup-modal {
    display: none;
    position: fixed;
    z-index: 4000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    animation: fadeIn 0.3s;
}

.pickup-modal.show {
    display: flex;
    align-items: center;
    justify-content: center;
}

        .pickup-modal-content {
            background: white;
            border-radius: 20px;
            max-width: 480px;
            width: 90%;
            box-shadow: 0 30px 80px rgba(0,0,0,0.4);
            overflow: hidden;
            animation: slideUp 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 3px solid rgba(255, 255, 255, 0.2);
        }

        .pickup-modal-header {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            padding: 25px 25px;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

.pickup-modal-header::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
    animation: pulse 3s ease-in-out infinite;
}

.pickup-modal-header h2 {
    font-size: 1.5em;
    margin: 0;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    position: relative;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
}

.pickup-modal-header i {
    font-size: 1.8em;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2));
    animation: bounce 2s ease-in-out infinite;
}

        .pickup-modal-body {
            padding: 25px;
            background: linear-gradient(to bottom, #ffffff 0%, #fafbfc 100%);
        }

.modal-pet-summary {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    padding: 25px;
    border-radius: 20px;
    margin-bottom: 28px;
    border: 2px solid #E8F4FC;
    display: flex;
    gap: 18px;
    align-items: center;
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
}

.modal-pet-summary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
}

.modal-pet-thumb {
    width: 85px;
    height: 85px;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
    border: 3px solid white;
}

.modal-pet-info h3 {
    color: #2E8BC0;
    font-size: 1.4em;
    margin: 0 0 5px 0;
    font-weight: 800;
}

.modal-pet-info p {
    color: #64748b;
    font-size: 0.95em;
    margin: 0;
    font-weight: 500;
}

.modal-adopter-info {
    background: linear-gradient(135deg, #E8F4FC 0%, #d4e9f7 100%);
    padding: 20px;
    border-radius: 18px;
    margin-bottom: 25px;
    border-left: 4px solid #3FA9F5;
    box-shadow: 0 4px 12px rgba(63, 169, 245, 0.1);
}

.modal-adopter-info p {
    color: #334155;
    font-size: 0.95em;
    margin: 8px 0;
    padding-left: 15px;
    position: relative;
}

.modal-adopter-info p::before {
    content: '●';
    position: absolute;
    left: 0;
    color: #3FA9F5;
}

.modal-adopter-info strong {
    color: #2E8BC0;
    font-weight: 700;
}

.pickup-details-preview {
    background: linear-gradient(135deg, #FFF9E6 0%, #fff4d4 100%);
    padding: 25px;
    border-radius: 18px;
    margin-bottom: 25px;
    border-left: 5px solid #FFD93D;
    box-shadow: 0 6px 15px rgba(255, 217, 61, 0.15);
}

.pickup-details-preview h4 {
    color: #2E8BC0;
    margin: 0 0 18px 0;
    font-size: 1.15em;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-item {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
    color: #334155;
    font-size: 0.95em;
    padding: 10px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 10px;
    transition: all 0.2s ease;
}

.detail-item:hover {
    background: rgba(255, 255, 255, 0.8);
    transform: translateX(5px);
}

.detail-item:last-child {
    margin-bottom: 0;
}

.detail-item i {
    color: #F6C90E;
    width: 22px;
    margin-top: 3px;
    filter: drop-shadow(0 2px 4px rgba(246, 201, 14, 0.3));
}

.detail-item strong {
    color: #2E8BC0;
    min-width: 85px;
    font-weight: 700;
}

        .pickup-modal-footer {
            padding: 20px;
            background: linear-gradient(to top, #f1f5f9 0%, #f8fafc 100%);
            border-top: 2px solid #e2e8f0;
            display: flex;
            gap: 18px;
        }

.pickup-modal-btn {
    flex: 1;
    padding: 16px;
    border: none;
    border-radius: 15px;
    font-weight: 800;
    cursor: pointer;
    font-size: 1em;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
}

.pickup-modal-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.4s ease, height 0.4s ease;
}

.pickup-modal-btn:hover::before {
    width: 300px;
    height: 300px;
}

.pickup-modal-btn-cancel {
    background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
    color: #334155;
    box-shadow: 0 4px 12px rgba(51, 65, 85, 0.1);
}

.pickup-modal-btn-cancel:hover {
    background: linear-gradient(135deg, #cbd5e1 0%, #b4bcc7 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(51, 65, 85, 0.15);
}

.pickup-modal-btn-confirm {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.pickup-modal-btn-confirm:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(50px) scale(0.9);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@@media (max-width: 768px) {
    .pet-summary {
        flex-direction: column;
        text-align: center;
    }

    .pickup-modal-content {
        width: 95%;
        margin: 20px;
    }

    .pickup-modal-header h2 {
        font-size: 1.6em;
    }

    .pickup-modal-footer {
        flex-direction: column;
    }

    .modal-pet-summary {
        flex-direction: column;
        text-align: center;
    }

    .header h1 {
        font-size: 2em;
    }

    .content {
        padding: 30px 25px;
    }
}
    </style>
</head>
<body>
    <div class="container">
        <div class="pickup-card">
            <div class="header">
                <i class="fas fa-map-marker-alt"></i>
                <h1>Set Pickup Details</h1>
                <p>Arrange the pickup for @Model.Pet.Name</p>
            </div>

            <div class="content">
                <!-- Adopter Information -->
                <div class="adopter-info">
                    <h3><i class="fas fa-user-check"></i> Approved Adopter</h3>
                    <p><strong>Name:</strong> @Model.User.FullName</p>
                    <p><strong>Email:</strong> @Model.User.Email</p>
                    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                    <p style="margin-top: 10px; font-size: 0.9em; color: #64748b;">
                        <i class="fas fa-info-circle"></i> The adopter will receive your contact information along with the pickup details.
                    </p>
                </div>

                <!-- Pet Summary -->
                <div class="pet-summary">
                    <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/100" : Model.Pet.ImageUrl)"
                         alt="@Model.Pet.Name" class="pet-thumb">
                    <div class="pet-details">
                        <h4>@Model.Pet.Name</h4>
                        <p>@Model.Pet.Breed • @Model.Pet.AgeDisplay • @Model.Pet.Gender</p>
                    </div>
                </div>

                <!-- Important Notice -->
                <div class="info-banner">
                    <h4><i class="fas fa-exclamation-triangle"></i> Important</h4>
                    <ul>
                        <li>Provide a specific pickup location (your address or a meeting point)</li>
                        <li>Choose a convenient date and time for both parties</li>
                        <li>The adopter will receive your contact information to coordinate</li>
                        <li>Make sure @Model.Pet.Name is ready with all necessary items (vaccines, records, etc.)</li>
                    </ul>
                </div>

                <!-- Pickup Details Form -->
                @using (Html.BeginForm("CustomerSetPickupDetails", "MyPets", FormMethod.Post, new { id = "pickupForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ApplicationId" />

                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-map-pin"></i>
                            Pickup Information
                        </div>

                        <div class="form-group">
                            <label>Pickup Location <span class="required">*</span></label>
                            <input type="text"
                                   id="pickupLocation"
                                   name="pickupLocation"
                                   placeholder="Enter full address or meeting point"
                                   required
                                   maxlength="500" />
                            <div class="help-text">
                                Example: "123 Main St, Quezon City" or "SM North EDSA Main Entrance"
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Pickup Date & Time <span class="required">*</span></label>
                            <input type="datetime-local"
                                   id="pickupDate"
                                   name="pickupDate"
                                   required
                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <div class="help-text">
                                Choose a date and time that works for both you and the adopter
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Additional Notes (Optional)</label>
                            <textarea id="pickupNotes"
                                      name="pickupNotes"
                                      placeholder="Any special instructions, items to bring, parking information, etc."
                                      maxlength="1000"></textarea>
                            <div class="help-text">
                                Example: "Please bring a pet carrier. Parking available at the front."
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a href="@Url.Action("CustomerDashboard", "MyPets")" class="btn btn-back">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                        <button type="button" class="btn btn-submit" id="submitPickupBtn">
                            <i class="fas fa-paper-plane"></i> Send Pickup Details
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Pickup Confirmation Modal -->
    <div id="pickupModal" class="pickup-modal">
        <div class="pickup-modal-content">
            <div class="pickup-modal-header">
                <h2>
                    <i class="fas fa-check-circle"></i>
                    Confirm Pickup Details
                </h2>
            </div>

            <div class="pickup-modal-body">
                <div class="modal-pet-summary">
                    <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/80" : Model.Pet.ImageUrl)"
                         alt="@Model.Pet.Name" class="modal-pet-thumb">
                    <div class="modal-pet-info">
                        <h3>@Model.Pet.Name</h3>
                        <p>@Model.Pet.Breed • @Model.Pet.AgeDisplay</p>
                    </div>
                </div>

                <div class="modal-adopter-info">
                    <p><strong>Adopter:</strong> @Model.User.FullName</p>
                    <p><strong>Email:</strong> @Model.User.Email</p>
                    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                </div>

                <div class="pickup-details-preview">
                    <h4><i class="fas fa-info-circle"></i> Pickup Details</h4>
                    <div class="detail-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <strong>Location:</strong>
                            <span id="modalLocation"></span>
                        </div>
                    </div>
                    <div class="detail-item">
                        <i class="fas fa-calendar-alt"></i>
                        <div>
                            <strong>Date & Time:</strong>
                            <span id="modalDateTime"></span>
                        </div>
                    </div>
                    <div class="detail-item" id="modalNotesContainer" style="display: none;">
                        <i class="fas fa-sticky-note"></i>
                        <div>
                            <strong>Notes:</strong>
                            <span id="modalNotes"></span>
                        </div>
                    </div>
                </div>

                <p style="color: #64748b; font-size: 0.9em; text-align: center;">
                    <i class="fas fa-info-circle"></i> The adopter will be notified via email with these details and your contact information.
                </p>
            </div>

            <div class="pickup-modal-footer">
                <button class="pickup-modal-btn pickup-modal-btn-cancel" onclick="closePickupModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button class="pickup-modal-btn pickup-modal-btn-confirm" id="confirmPickupBtn">
                    <i class="fas fa-paper-plane"></i> Send Details
                </button>
            </div>
        </div>
    </div>

    <script>
        // Set minimum datetime to now
        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.querySelector('input[type="datetime-local"]');
            if (dateInput) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                dateInput.min = now.toISOString().slice(0, 16);
            }

            // Submit button handler - show modal instead of direct submit
            document.getElementById('submitPickupBtn').addEventListener('click', function (e) {
                e.preventDefault();

                const location = document.getElementById('pickupLocation').value.trim();
                const date = document.getElementById('pickupDate').value;
                const notes = document.getElementById('pickupNotes').value.trim();

                // Validation
                if (!location || !date) {
                    alert('Please fill in all required fields.');
                    return;
                }

                const selectedDate = new Date(date);
                const now = new Date();

                if (selectedDate < now) {
                    alert('Please select a future date and time.');
                    return;
                }

                // Show confirmation modal with details
                showPickupModal(location, date, notes);
            });

            // Confirm button in modal - actually submit the form
            document.getElementById('confirmPickupBtn').addEventListener('click', function () {
                document.getElementById('pickupForm').submit();
            });
        });

        function showPickupModal(location, dateTime, notes) {
            const modal = document.getElementById('pickupModal');

            // Format date for display
            const date = new Date(dateTime);
            const formattedDate = date.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            // Populate modal
            document.getElementById('modalLocation').textContent = location;
            document.getElementById('modalDateTime').textContent = formattedDate;

            // Show/hide notes section
            const notesContainer = document.getElementById('modalNotesContainer');
            if (notes) {
                document.getElementById('modalNotes').textContent = notes;
                notesContainer.style.display = 'flex';
            } else {
                notesContainer.style.display = 'none';
            }

            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closePickupModal() {
            const modal = document.getElementById('pickupModal');
            modal.classList.remove('show');
            document.body.style.overflow = '';
        }

        // Close modal when clicking outside
        document.getElementById('pickupModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closePickupModal();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closePickupModal();
            }
        });
    </script>
</body>
</html>