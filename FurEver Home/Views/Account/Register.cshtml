@model FurEver_Home.Models.RegisterViewModel
@{
    ViewBag.Title = "Sign Up - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .register-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
            max-width: 520px;
            width: 100%;
            padding: 48px 40px;
            position: relative;
            overflow: hidden;
        }

        .register-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #FFD93D 0%, #3FA9F5 100%);
        }

        .logo-container {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo-img {
            width: 200px;
            height: auto;
            margin-bottom: 24px;
        }

        .welcome-text {
            font-size: 28px;
            font-weight: 700;
            color: #2E8BC0;
            margin-bottom: 8px;
            text-align: center;
        }

        .subtitle {
            font-size: 15px;
            color: #64748b;
            text-align: center;
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #334155;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 18px;
        }

        .form-group input {
            width: 100%;
            padding: 14px 16px 14px 48px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s ease;
            outline: none;
            background: #f8fafc;
        }

        .form-group input:focus {
            border-color: #FFD93D;
            background: white;
            box-shadow: 0 0 0 4px rgba(255, 217, 61, 0.1);
        }

        .form-group input.input-validation-error {
            border-color: #ef4444;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
            display: block;
        }

        .file-upload-wrapper {
            margin-top: 24px;
            padding: 24px;
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s;
        }

        .file-upload-wrapper:hover {
            border-color: #FFD93D;
            background: #fffbeb;
        }

        .file-upload-wrapper input[type="file"] {
            display: none;
        }

        .file-upload-label {
            display: block;
            cursor: pointer;
        }

        .file-upload-icon {
            font-size: 40px;
            color: #FFD93D;
            margin-bottom: 12px;
        }

        .file-upload-text {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .file-upload-hint {
            color: #94a3b8;
            font-size: 12px;
        }

        .id-type-selector {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

      

        .btn-register {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(255, 217, 61, 0.3);
            margin-top: 24px;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
        }

        .btn-register:active {
            transform: translateY(0);
        }

        .divider {
            text-align: center;
            margin: 24px 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #e2e8f0;
        }

        .divider span {
            background: white;
            padding: 0 16px;
            color: #94a3b8;
            font-size: 14px;
            position: relative;
            z-index: 1;
        }

        .signin-link {
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        .signin-link a {
            color: #3FA9F5;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
        }

        .signin-link a:hover {
            color: #2E8BC0;
        }

        .back-home {
            text-align: center;
            margin-top: 24px;
        }

        .back-home a {
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s;
        }

        .back-home a:hover {
            color: #FFD93D;
        }

        .info-note {
            background: #eff6ff;
            border-left: 4px solid #3FA9F5;
            padding: 14px 16px;
            border-radius: 8px;
            margin-top: 24px;
            font-size: 13px;
            color: #1e40af;
        }

        .info-note i {
            margin-right: 8px;
        }

        @@media (max-width: 480px) {
            .register-container {
                padding: 36px 28px;
            }

            .welcome-text {
                font-size: 24px;
            }

            .logo-img {
                width: 160px;
            }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="logo-container">
            <img src="~/Content/Images/full_furever.png" alt="FurEver Home" class="logo-img">
        </div>

        <h1 class="welcome-text">Join FurEver Home</h1>
        <p class="subtitle">Create your account to start helping pets</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.FullName)
                <div class="input-wrapper">
                    <i class="fas fa-user input-icon"></i>
                    @Html.TextBoxFor(m => m.FullName, new { placeholder = "Enter your full name" })
                </div>
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                <div class="input-wrapper">
                    <i class="fas fa-envelope input-icon"></i>
                    @Html.TextBoxFor(m => m.Email, new { placeholder = "Enter your email", type = "email" })
                </div>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    @Html.PasswordFor(m => m.Password, new { placeholder = "Create a password (min. 6 characters)" })
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword)
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Confirm your password" })
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                <div class="form-group">
                    <label>ID Type</label>
                    @Html.TextBoxFor(m => m.IDType, new { placeholder = "e.g., National ID, Passport, Driver's License, Postal ID, etc.", @class = "form-control" })
                    <small style="color: #64748b; display: block; margin-top: 8px;">
                        <i class="fas fa-info-circle"></i> Enter any valid government-issued ID type
                    </small>
                </div>
            </div>

            <div class="file-upload-wrapper">
                <label for="idUpload" class="file-upload-label">
                    <div class="file-upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <div class="file-upload-text">Upload Your Valid ID</div>
                    <div class="file-upload-hint">Click to browse or drag and drop</div>
                    <div class="file-upload-hint">PNG, JPG or PDF (Max 5MB)</div>
                </label>
                <input type="file" id="idUpload" name="IDImage" accept="image/*,.pdf">
                <div id="fileName" style="margin-top: 12px; color: #3FA9F5; font-size: 14px; font-weight: 600;"></div>
            </div>

            <div class="info-note">
                <i class="fas fa-info-circle"></i>
                Your ID will be verified by our admin team within 24-48 hours. This helps us ensure the safety of our pets and community.
            </div>

            <button type="submit" class="btn-register">
                <i class="fas fa-user-plus"></i> Create Account
            </button>
        }

        <div class="divider">
            <span>or</span>
        </div>

        <div class="signin-link">
            Already have an account? <a href="@Url.Action("Login", "Account")">Sign In</a>
        </div>

     
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // File upload preview
        document.getElementById('idUpload').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('fileName').textContent = '✓ ' + fileName;
            }
        });

       
    </script>
</body>
</html>