@model FurEver_Home.Models.User
@{
    ViewBag.Title = "My Profile - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .profile-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .profile-header {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            padding: 40px;
            text-align: center;
            color: white;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 5px solid white;
            margin: 0 auto 20px;
            object-fit: cover;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3em;
            font-weight: 700;
            color: #3FA9F5;
        }

        .profile-name {
            font-size: 2em;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .profile-email {
            opacity: 0.9;
        }

        .profile-body {
            padding: 40px;
        }

        .status-banner {
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .status-verified {
            background: #d1fae5;
            color: #065f46;
            border: 2px solid #a7f3d0;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
            border: 2px solid #fde68a;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

            .form-group input,
            .form-group textarea {
                width: 100%;
                padding: 14px 16px;
                border: 2px solid #e2e8f0;
                border-radius: 12px;
                font-size: 15px;
                transition: all 0.3s;
                outline: none;
                background: #f8fafc;
            }

                .form-group input:focus,
                .form-group textarea:focus {
                    border-color: #3FA9F5;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
                }

        .image-upload-container {
            position: relative;
        }

        .image-thumbnail-wrapper {
            position: relative;
            width: 200px;
            height: 200px;
            margin-bottom: 20px;
            cursor: pointer;
            border-radius: 15px;
            overflow: hidden;
            border: 3px solid #3FA9F5;
        }

        .id-thumbnail-wrapper {
            position: relative;
            width: 100%;
            max-width: 280px;
            margin-bottom: 20px;
            cursor: pointer;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid #e2e8f0;
        }

        .current-image-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .current-id-preview {
            width: 100%;
            height: auto;
            max-height: 280px;
            object-fit: contain;
            display: block;
            transition: transform 0.3s ease;
        }

        .image-hover-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 70%, transparent 100%);
            color: white;
            padding: 15px;
            transform: translateY(100%);
            transition: transform 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .image-thumbnail-wrapper:hover .image-hover-overlay,
        .id-thumbnail-wrapper:hover .image-hover-overlay {
            transform: translateY(0);
        }

        .image-thumbnail-wrapper:hover .current-image-preview,
        .id-thumbnail-wrapper:hover .current-id-preview {
            transform: scale(1.05);
        }

        .pdf-thumbnail {
            width: 100%;
            padding: 40px;
            background: #f8fafc;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        .file-upload-box {
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            background: #f8fafc;
            cursor: pointer;
            transition: all 0.3s;
        }

            .file-upload-box:hover {
                border-color: #3FA9F5;
                background: #eff6ff;
            }

            .file-upload-box input[type="file"] {
                display: none;
            }

        .upload-icon {
            font-size: 3em;
            color: #3FA9F5;
            margin-bottom: 15px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-save {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            color: white;
        }

            .btn-save:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(63, 169, 245, 0.4);
            }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .image-label {
            display: block;
            color: #64748b;
            font-size: 0.9em;
            font-weight: 600;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="profile-card">
            <div class="profile-header">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Profile" class="profile-avatar">
                }
                else
                {
                    <div class="profile-avatar">@Model.FullName.Substring(0, 1).ToUpper()</div>
                }
                <div class="profile-name">@Model.FullName</div>
                <div class="profile-email"><i class="fas fa-envelope"></i> @Model.Email</div>
            </div>

            <div class="profile-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                }

                @if (Model.IDStatus == "Verified")
                {
                    <div class="status-banner status-verified">
                        <i class="fas fa-check-circle" style="font-size: 2em;"></i>
                        <div>
                            <strong>ID Verified!</strong><br>
                            You can now post pets for adoption.
                        </div>
                    </div>
                }
                else if (Model.IDStatus == "Pending")
                {
                    <div class="status-banner status-pending">
                        <i class="fas fa-clock" style="font-size: 2em;"></i>
                        <div>
                            <strong>ID Verification Pending</strong><br>
                            Your ID is being reviewed by our admin team.
                        </div>
                    </div>
                }

                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name</label>
                            @Html.TextBoxFor(m => m.FullName, new { placeholder = "Your full name" })
                        </div>

                        <div class="form-group">
                            <label>Email (Cannot be changed)</label>
                            <input type="email" value="@Model.Email" disabled style="background: #e2e8f0; cursor: not-allowed;">
                        </div>

                        <div class="form-group">
                            <label>Phone Number</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { placeholder = "Your phone number" })
                        </div>

                        <div class="form-group">
                            <label>Age</label>
                            @Html.TextBoxFor(m => m.Age, new { type = "number", placeholder = "Your age" })
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Address</label>
                        @Html.TextAreaFor(m => m.Address, new { placeholder = "Your complete address", rows = "3" })
                    </div>

                    <div class="form-grid">
                        <!-- ✅ FIXED: Profile Picture Section -->
                        <div class="form-group">
                            <label>Profile Picture</label>
                            <div class="image-upload-container">
                                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                {
                                    <span class="image-label">Current Profile Picture:</span>
                                    <div class="image-thumbnail-wrapper" onclick="document.getElementById('profilePic').click()">
                                        <img src="@Model.ProfilePictureUrl" alt="Profile" class="current-image-preview" />
                                        <div class="image-hover-overlay">
                                            <i class="fas fa-camera"></i>
                                            <span>Edit Profile Photo</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="file-upload-box" onclick="document.getElementById('profilePic').click()">
                                        <div class="upload-icon"><i class="fas fa-camera"></i></div>
                                        <div>Upload Profile Picture</div>
                                        <small style="color: #64748b;">JPG, PNG (Max 5MB)</small>
                                    </div>
                                }

                                <input type="file" id="profilePic" name="ProfilePicture" accept="image/*" style="display: none;">
                                <div id="profileFileName" style="margin-top: 12px; color: #3FA9F5; font-weight: 600;"></div>
                            </div>
                        </div>

                        <!-- ✅ FIXED: Valid ID Section -->
                        <div class="form-group">
                            <label>Valid ID @(Model.IDStatus == "Verified" ? "(Verified ✓)" : "")</label>
                            <div class="image-upload-container">
                                @if (!string.IsNullOrEmpty(Model.IDImageUrl))
                                {
                                    <span class="image-label">Current ID Document:</span>
                                    if (Model.IDImageUrl.EndsWith(".pdf"))
                                    {
                                        <div class="id-thumbnail-wrapper" onclick="document.getElementById('idPic').click()">
                                            <div class="pdf-thumbnail">
                                                <i class="fas fa-file-pdf" style="font-size: 4em; color: #ef4444; margin-bottom: 15px;"></i>
                                                <div style="color: #64748b; font-weight: 600; margin-bottom: 8px;">PDF Document</div>
                                                <a href="@Model.IDImageUrl" target="_blank" style="color: #3FA9F5; font-size: 0.9em;" onclick="event.stopPropagation();">View PDF</a>
                                            </div>
                                            <div class="image-hover-overlay">
                                                <i class="fas fa-id-card"></i>
                                                <span>Change Valid ID</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="id-thumbnail-wrapper" onclick="document.getElementById('idPic').click()">
                                            <img src="@Model.IDImageUrl" alt="ID Document" class="current-id-preview" />
                                            <div class="image-hover-overlay">
                                                <i class="fas fa-id-card"></i>
                                                <span>Change Valid ID</span>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="file-upload-box" onclick="document.getElementById('idPic').click()">
                                        <div class="upload-icon"><i class="fas fa-id-card"></i></div>
                                        <div>Upload Valid ID</div>
                                        <small style="color: #64748b;">JPG, PNG, PDF (Max 5MB)</small>
                                    </div>
                                }

                                <input type="file" id="idPic" name="IDImage" accept="image/*,.pdf" style="display: none;">
                                <div id="idFileName" style="margin-top: 12px; color: #3FA9F5; font-weight: 600;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a href="@Url.Action("Index", "Pets")" class="btn btn-back">
                            <i class="fas fa-arrow-left"></i> Back to Home
                        </a>
                        <button type="submit" class="btn btn-save">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // Profile picture file name display
        document.getElementById('profilePic').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('profileFileName').textContent = '✓ Selected: ' + fileName;
            }
        });

        // ID document file name display
        document.getElementById('idPic').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('idFileName').textContent = '✓ Selected: ' + fileName;
            }
        });
    </script>
</body>
</html>