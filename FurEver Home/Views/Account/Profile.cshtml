    <script>
    // Check and show status modal on page load
    window.addEventListener('DOMContentLoaded', function() {
        var idStatus = '@Model.IDStatus'; // Get ID status from model

        if (idStatus === 'Pending') {
            // Always show for pending status
            showStatusModal('pending');
        } else if (idStatus === 'Verified') {
            // Only show once for verified status
            var hasSeenVerified = localStorage.getItem('hasSeenVerifiedModal');
            if (!hasSeenVerified) {
                showStatusModal('verified');
                localStorage.setItem('hasSeenVerifiedModal', 'true');
            }
        }
    });

    function showStatusModal(status) {
        var modal = document.getElementById('statusModal');
        var pendingDiv = document.getElementById('pendingStatus');
        var verifiedDiv = document.getElementById('verifiedStatus');

        if (status === 'pending') {
            pendingDiv.style.display = 'block';
            verifiedDiv.style.display = 'none';
        } else if (status === 'verified') {
            pendingDiv.style.display = 'none';
            verifiedDiv.style.display = 'block';
        }

        modal.classList.add('show');
    }

    function closeStatusModal() {
        document.getElementById('statusModal').classList.remove('show');
    }

    // Close on background click
    document.addEventListener('click', function(e) {
        var modal = document.getElementById('statusModal');
        if (e.target === modal) {
            closeStatusModal();
        }
    });

    // Close on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeStatusModal();
        }
    });



    </script>


    <script>
// ==================== TWO-FACTOR AUTHENTICATION FUNCTIONS ====================

function initiate2FA() {
    $.ajax({
        url: '@Url.Action("EnableTwoFactor", "Account")',
        type: 'POST',
        success: function(response) {
            if (response.success) {
                // Show QR Code
                $('#qrCodeImage').attr('src', '@Url.Action("GetQRCode", "Account")?' + new Date().getTime());
                $('#secretKey').text(response.secret);

                // ✅ FIXED: Use css display flex to center modal
                $('#twoFaModal').css('display', 'flex').addClass('show');

                setupVerificationInputs();
            } else {
                alert('Failed to generate 2FA setup. Please try again.');
            }
        },
        error: function() {
            alert('An error occurred. Please try again.');
        }
    });
}

function setupVerificationInputs() {
    const verifyInputs = document.querySelectorAll('#step2 .code-digit');

    verifyInputs.forEach((input, index) => {
        input.value = '';
        input.classList.remove('filled');

        input.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length === 1) {
                this.classList.add('filled');
                if (index < verifyInputs.length - 1) {
                    verifyInputs[index + 1].focus();
                }
            } else {
                this.classList.remove('filled');
            }
        });

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Backspace' && this.value === '' && index > 0) {
                verifyInputs[index - 1].focus();
            }
        });
    });

    verifyInputs[0].focus();
}

function showStep2() {
    $('#step1').hide();
    $('#step2').show();
    $('#verify1').focus();
}

function showStep1() {
    $('#step2').hide();
    $('#step1').show();
    $('#verifyError').hide();
}

function confirm2FA() {
    const code = $('#verify1').val() + $('#verify2').val() + $('#verify3').val() +
                 $('#verify4').val() + $('#verify5').val() + $('#verify6').val();

    if (code.length !== 6) {
        $('#verifyErrorText').text('Please enter all 6 digits');
        $('#verifyError').show();
        return;
    }

    $('#confirmBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Verifying...');

    $.ajax({
        url: '@Url.Action("ConfirmTwoFactor", "Account")',
        type: 'POST',
        data: { code: code },
        success: function(response) {
            if (response.success) {
                closeTwoFaModal();
                location.reload(); // Reload to show enabled state
            } else {
                $('#verifyErrorText').text(response.message);
                $('#verifyError').show();
                $('#confirmBtn').prop('disabled', false).html('<i class="fas fa-check"></i> Enable 2FA');
            }
        },
        error: function() {
            $('#verifyErrorText').text('An error occurred. Please try again.');
            $('#verifyError').show();
            $('#confirmBtn').prop('disabled', false).html('<i class="fas fa-check"></i> Enable 2FA');
        }
    });
}

function closeTwoFaModal() {
    // ✅ FIXED: Remove class and hide properly
    $('#twoFaModal').removeClass('show').css('display', 'none');
    $('#step1').show();
    $('#step2').hide();
    $('#verifyError').hide();
    // Clear inputs
    $('#verify1, #verify2, #verify3, #verify4, #verify5, #verify6').val('').removeClass('filled');
}

function disable2FA() {
    // ✅ FIXED: Use css display flex to center modal
    $('#disableTwoFaModal').css('display', 'flex').addClass('show');
    $('#disablePassword').val('').focus();
    $('#disableError').hide();
}

function closeDisableTwoFaModal() {
    // ✅ FIXED: Remove class and hide properly
    $('#disableTwoFaModal').removeClass('show').css('display', 'none');
    $('#disablePassword').val('');
    $('#disableError').hide();
}

function confirmDisable2FA() {
    const password = $('#disablePassword').val();

    if (!password) {
        $('#disableErrorText').text('Please enter your password');
        $('#disableError').show();
        return;
    }

    $('#disableBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');

    $.ajax({
        url: '@Url.Action("DisableTwoFactor", "Account")',
        type: 'POST',
        data: { password: password },
        success: function(response) {
            if (response.success) {
                closeDisableTwoFaModal();
                location.reload(); // Reload to show disabled state
            } else {
                $('#disableErrorText').text(response.message);
                $('#disableError').show();
                $('#disableBtn').prop('disabled', false).html('<i class="fas fa-shield-xmark"></i> Disable 2FA');
            }
        },
        error: function() {
            $('#disableErrorText').text('An error occurred. Please try again.');
            $('#disableError').show();
            $('#disableBtn').prop('disabled', false).html('<i class="fas fa-shield-xmark"></i> Disable 2FA');
        }
    });
}

// Close modals on background click
$('#twoFaModal, #disableTwoFaModal').on('click', function(e) {
    if (e.target === this) {
        closeTwoFaModal();
        closeDisableTwoFaModal();
    }
});

// Close modals on ESC key
$(document).on('keydown', function(e) {
    if (e.key === 'Escape') {
        closeTwoFaModal();
        closeDisableTwoFaModal();
    }
});
    </script>

    <script>
    // ==================== CROP FUNCTIONALITY ====================
    let isDragging = false;
    let startX, startY;
    let offsetX = 0, offsetY = 0;
    let zoom = 1;
    let currentImageType = '';
    let currentImageSrc = '';

    const imageContainer = document.getElementById('imageContainer');
    const editorImage = document.getElementById('editorImage');
    const previewImage = document.getElementById('previewImage');
    const zoomSlider = document.getElementById('zoomSlider');

    function openCropModal(imageType, imageUrl) {
        currentImageType = imageType;
        currentImageSrc = imageUrl;
        const modal = document.getElementById('cropModal');
        const titleEl = document.getElementById('modalTitle');
        const previewOverlay = document.querySelector('.preview-overlay');
        const previewCircle = document.querySelector('.preview-circle');
        const editorDiv = document.querySelector('.image-editor');

        if (imageType === 'profile') {
            titleEl.innerHTML = '<i class="fas fa-crop"></i> Reposition Profile Picture';
            // Circle crop for profile
            previewOverlay.style.borderRadius = '50%';
            previewOverlay.style.width = '200px';
            previewOverlay.style.height = '200px';
            previewCircle.style.borderRadius = '50%';
            previewCircle.style.width = '150px';
            previewCircle.style.height = '150px';
        } else {
            titleEl.innerHTML = '<i class="fas fa-crop"></i> Reposition ID Document';
            // Rectangle crop for ID (3:2 aspect ratio - standard ID size)
            previewOverlay.style.borderRadius = '12px';
            previewOverlay.style.width = '360px';
            previewOverlay.style.height = '240px';
            previewCircle.style.borderRadius = '12px';
            previewCircle.style.width = '300px';
            previewCircle.style.height = '200px';
        }

        // Load image and auto-fit it
        editorImage.onload = function() {
            // Calculate scale to fit image properly
            const editorWidth = editorDiv.clientWidth;
            const editorHeight = editorDiv.clientHeight;
            const imgAspect = editorImage.naturalWidth / editorImage.naturalHeight;
            const editorAspect = editorWidth / editorHeight;

            // Reset image container size
            imageContainer.style.width = '100%';
            imageContainer.style.height = '100%';

            // Set image to cover the editor area
            if (imgAspect > editorAspect) {
                // Image is wider - fit to height
                editorImage.style.width = 'auto';
                editorImage.style.height = '100%';
                editorImage.style.left = '50%';
                editorImage.style.top = '0';
                editorImage.style.transform = 'translateX(-50%)';
            } else {
                // Image is taller - fit to width
                editorImage.style.width = '100%';
                editorImage.style.height = 'auto';
                editorImage.style.left = '0';
                editorImage.style.top = '50%';
                editorImage.style.transform = 'translateY(-50%)';
            }

            resetPosition();
            updateImagePosition();
            modal.classList.add('show');
        };

        editorImage.src = imageUrl;
        previewImage.src = imageUrl;
    }

    function closeCropModal() {
        document.getElementById('cropModal').classList.remove('show');
    }

    // Mouse drag handlers
    imageContainer.addEventListener('mousedown', (e) => {
        isDragging = true;
        imageContainer.classList.add('dragging');
        startX = e.clientX - offsetX;
        startY = e.clientY - offsetY;
    });

    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        offsetX = e.clientX - startX;
        offsetY = e.clientY - startY;
        updateImagePosition();
    });

    document.addEventListener('mouseup', () => {
        isDragging = false;
        imageContainer.classList.remove('dragging');
    });

    // Touch drag handlers
    imageContainer.addEventListener('touchstart', (e) => {
        isDragging = true;
        const touch = e.touches[0];
        startX = touch.clientX - offsetX;
        startY = touch.clientY - offsetY;
    });

    document.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const touch = e.touches[0];
        offsetX = touch.clientX - startX;
        offsetY = touch.clientY - startY;
        updateImagePosition();
    });

    document.addEventListener('touchend', () => {
        isDragging = false;
    });

    function updateImagePosition() {
        const transform = `translate(${offsetX}px, ${offsetY}px) scale(${zoom})`;
        imageContainer.style.transform = transform;

        // Update preview with same transform
        const previewCircle = document.querySelector('.preview-circle');
        const previewImg = document.getElementById('previewImage');

        // Calculate the crop area
        const editorRect = document.querySelector('.image-editor').getBoundingClientRect();
        const overlayRect = document.querySelector('.preview-overlay').getBoundingClientRect();
        const imgRect = editorImage.getBoundingClientRect();

        // Calculate position relative to overlay
        const relativeX = ((overlayRect.left - imgRect.left) / imgRect.width) * 100;
        const relativeY = ((overlayRect.top - imgRect.top) / imgRect.height) * 100;
        const relativeWidth = (overlayRect.width / imgRect.width) * 100;
        const relativeHeight = (overlayRect.height / imgRect.height) * 100;

        // Apply to preview
        previewImg.style.width = `${100 / (relativeWidth / 100)}%`;
        previewImg.style.height = `${100 / (relativeHeight / 100)}%`;
        previewImg.style.objectFit = 'cover';
        previewImg.style.objectPosition = `${relativeX * (100 / relativeWidth)}% ${relativeY * (100 / relativeHeight)}%`;
    }

    function setZoom(value) {
        zoom = value / 100;
        zoomSlider.value = value;
        updateImagePosition();
    }

    function zoomIn() {
        const newZoom = Math.min(200, parseInt(zoomSlider.value) + 10);
        setZoom(newZoom);
    }

    function zoomOut() {
        const newZoom = Math.max(50, parseInt(zoomSlider.value) - 10);
        setZoom(newZoom);
    }

    function resetPosition() {
        offsetX = 0;
        offsetY = 0;
        zoom = 1;
        zoomSlider.value = 100;
        imageContainer.style.transform = 'translate(0, 0) scale(1)';
        updateImagePosition();
    }

    // ==================== APPLY CROP WITH CANVAS ====================
    function applyCrop() {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        // Different output sizes for profile vs ID
        let outputWidth, outputHeight;
        if (currentImageType === 'profile') {
            outputWidth = 400;
            outputHeight = 400; // Square for profile
        } else {
            outputWidth = 1200;
            outputHeight = 800; // 3:2 ratio for ID (landscape)
        }

        canvas.width = outputWidth;
        canvas.height = outputHeight;

        const img = new Image();
        img.crossOrigin = 'anonymous';

        img.onload = function() {
            // Get all the necessary dimensions
            const editorRect = document.querySelector('.image-editor').getBoundingClientRect();
            const overlayRect = document.querySelector('.preview-overlay').getBoundingClientRect();
            const containerRect = imageContainer.getBoundingClientRect();
            const imgRect = editorImage.getBoundingClientRect();

            // Calculate overlay position relative to the actual image
            const scaleX = img.naturalWidth / imgRect.width;
            const scaleY = img.naturalHeight / imgRect.height;

            // Calculate crop area in image coordinates
            const cropX = (overlayRect.left - imgRect.left) * scaleX;
            const cropY = (overlayRect.top - imgRect.top) * scaleY;
            const cropWidth = overlayRect.width * scaleX;
            const cropHeight = overlayRect.height * scaleY;

            // Draw cropped image to canvas
            ctx.drawImage(
                img,
                Math.max(0, cropX),
                Math.max(0, cropY),
                cropWidth,
                cropHeight,
                0, 0,
                outputWidth, outputHeight
            );

            // Convert canvas to blob
            canvas.toBlob(function(blob) {
                if (!blob) {
                    alert('Failed to crop image. Please try again.');
                    return;
                }

                const fileName = currentImageType === 'profile'
                    ? 'profile_cropped.jpg'
                    : 'id_cropped.jpg';

                const croppedFile = new File([blob], fileName, {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                });

                // Update the file input
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(croppedFile);

                if (currentImageType === 'profile') {
                    // Update profile picture input
                    document.getElementById('profilePic').files = dataTransfer.files;
                    document.getElementById('profileFileName').textContent = '✓ Cropped: ' + fileName;

                    // Update the thumbnail preview
                    const wrapper = document.querySelector('.image-thumbnail-wrapper img');
                    if (wrapper) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            wrapper.src = e.target.result;
                        };
                        reader.readAsDataURL(croppedFile);
                    }
                } else {
                    // Update ID document input
                    document.getElementById('idPic').files = dataTransfer.files;
                    document.getElementById('idFileName').textContent = '✓ Cropped: ' + fileName;

                    // Update the ID preview
                    const wrapper = document.querySelector('.id-thumbnail-wrapper img');
                    if (wrapper) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            wrapper.src = e.target.result;
                        };
                        reader.readAsDataURL(croppedFile);
                    }
                }

                closeCropModal();
            }, 'image/jpeg', 0.92); // 92% quality
        };

        img.onerror = function() {
            alert('Failed to load image. Please try again.');
        };

        img.src = currentImageSrc;
    }

    // Close modal on background click
    document.getElementById('cropModal').addEventListener('click', function (e) {
        if (e.target === this) {
            closeCropModal();
        }
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeCropModal();
        }
    });

    // ==================== FILE INPUT HANDLERS ====================

    // Profile Picture - Auto-open crop modal for new uploads
    document.getElementById('profilePic').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            if (file.type.startsWith('image/')) {
                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    // Open crop modal immediately for new uploads
                    openCropModal('profile', event.target.result);
                };
                reader.readAsDataURL(file);

                document.getElementById('profileFileName').textContent = '✓ Selected: ' + file.name;
            } else {
                alert('Please select a valid image file (JPG, PNG)');
                this.value = '';
            }
        }
    });

    // ID Document - Auto-open crop modal for images only
    document.getElementById('idPic').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            // Validate file size (5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('File size must be less than 5MB');
                this.value = '';
                return;
            }

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    // Open crop modal for ID images
                    openCropModal('id', event.target.result);
                };
                reader.readAsDataURL(file);
            } else if (file.type === 'application/pdf') {
                // PDF doesn't need cropping
                document.getElementById('idFileName').textContent = '✓ Selected: ' + file.name;
            } else {
                alert('Please select a valid file (JPG, PNG, PDF)');
                this.value = '';
            }
        }
    });

    // ==================== HELPER FUNCTION FOR CLICKING EXISTING IMAGES ====================

    // This function is called from the onclick in your Razor view
    // It's defined in the view as: onclick="openCropModalOrUpload('profile', '@Model.ProfilePictureUrl')"
    window.openCropModalOrUpload = function(imageType, imageUrl) {
        if (imageUrl && imageUrl.trim() !== '') {
            // Image exists - open crop modal to reposition
            openCropModal(imageType, imageUrl);
        } else {
            // No image - open file picker
            if (imageType === 'profile') {
                document.getElementById('profilePic').click();
            } else {
                document.getElementById('idPic').click();
            }
        }
    };

    // ==================== UPLOAD NEW IMAGE FUNCTIONS ====================

    window.uploadNewProfilePic = function() {
        document.getElementById('profilePic').click();
    };

    window.uploadNewID = function() {
        // Show custom confirmation modal for ID change
        document.getElementById('confirmModal').classList.add('show');
    };

    window.confirmIDChange = function() {
        // User confirmed - open file picker
        document.getElementById('confirmModal').classList.remove('show');
        document.getElementById('idPic').click();
    };

    window.cancelIDChange = function() {
        // User cancelled - just close modal
        document.getElementById('confirmModal').classList.remove('show');
        };




    </script>
