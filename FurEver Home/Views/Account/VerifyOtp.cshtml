@model FurEver_Home.Models.VerifyOtpViewModel
@{
    ViewBag.Title = "Verify OTP - FurEver Home";
    Layout = null;
    var userName = ViewBag.FullName ?? "User";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .otp-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
            max-width: 480px;
            width: 100%;
            padding: 48px 40px;
            position: relative;
            overflow: hidden;
        }

            .otp-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #3FA9F5 0%, #FFD93D 100%);
            }

        .icon-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        .icon-circle i {
            font-size: 48px;
            color: #3FA9F5;
        }

        .welcome-text {
            font-size: 28px;
            font-weight: 700;
            color: #2E8BC0;
            margin-bottom: 12px;
            text-align: center;
        }

        .subtitle {
            font-size: 15px;
            color: #64748b;
            text-align: center;
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .email-display {
            background: #eff6ff;
            padding: 14px 20px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 32px;
            border: 2px solid #bfdbfe;
        }

            .email-display i {
                color: #3FA9F5;
                margin-right: 8px;
            }

            .email-display strong {
                color: #1e40af;
                font-size: 16px;
            }

        .otp-input-wrapper {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin: 32px 0;
        }

        .otp-digit {
            width: 56px;
            height: 64px;
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            border: 3px solid #e2e8f0;
            border-radius: 12px;
            outline: none;
            transition: all 0.3s;
            background: #f8fafc;
            color: #2E8BC0;
        }

            .otp-digit:focus {
                border-color: #3FA9F5;
                background: white;
                box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
            }

            .otp-digit.filled {
                background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
                border-color: #3FA9F5;
            }

        .hidden-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .timer-box {
            background: #fef3c7;
            padding: 14px 20px;
            border-radius: 12px;
            text-align: center;
            margin: 24px 0;
            border: 2px solid #fde68a;
        }

            .timer-box i {
                color: #F6C90E;
                margin-right: 8px;
            }

        .timer-text {
            color: #92400e;
            font-weight: 600;
            font-size: 15px;
        }

        .countdown {
            font-size: 20px;
            font-weight: 700;
            color: #ea580c;
        }

        .btn-verify {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(63, 169, 245, 0.3);
            margin-top: 24px;
        }

            .btn-verify:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(63, 169, 245, 0.4);
            }

            .btn-verify:disabled {
                background: #cbd5e1;
                cursor: not-allowed;
                transform: none;
            }

        .resend-section {
            text-align: center;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #e2e8f0;
        }

        .resend-text {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .btn-resend {
            background: transparent;
            color: #3FA9F5;
            border: 2px solid #3FA9F5;
            padding: 12px 28px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
        }

            .btn-resend:hover:not(:disabled) {
                background: #3FA9F5;
                color: white;
            }

            .btn-resend:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                border-color: #cbd5e1;
                color: #94a3b8;
            }

        .back-login {
            text-align: center;
            margin-top: 20px;
        }

            .back-login a {
                color: #64748b;
                text-decoration: none;
                font-size: 14px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: color 0.3s;
            }

                .back-login a:hover {
                    color: #3FA9F5;
                }

        .alert {
            padding: 14px 16px;
            border-radius: 12px;
            margin-bottom: 24px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease;
        }

        @@keyframes slideIn {
            from {
                transform: translateY(-10px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .alert-success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .security-note {
            background: #f8fafc;
            padding: 16px;
            border-radius: 12px;
            margin-top: 24px;
            font-size: 13px;
            color: #475569;
            text-align: center;
            border: 1px solid #e2e8f0;
        }

            .security-note i {
                color: #3FA9F5;
                margin-right: 6px;
            }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s ease;
        }

        /* Loading/Sign In Animation Overlay */
        .signin-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.5s ease;
        }

            .signin-overlay.active {
                display: flex;
            }

        .signin-content {
            text-align: center;
            color: white;
        }

        .signin-spinner {
            width: 80px;
            height: 80px;
            border: 6px solid rgba(255, 255, 255, 0.3);
            border-top: 6px solid white;
            border-radius: 50%;
            margin: 0 auto 32px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .signin-icon {
            width: 100px;
            height: 100px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            animation: scaleUpDown 2s ease-in-out infinite;
        }

        @@keyframes scaleUpDown {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .signin-icon i {
            font-size: 50px;
            color: white;
        }

        .signin-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 12px;
            animation: fadeInUp 0.6s ease;
        }

        .signin-message {
            font-size: 18px;
            opacity: 0.9;
            animation: fadeInUp 0.8s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .signin-dots {
            display: inline-block;
            animation: dots 1.5s steps(4, end) infinite;
        }

        @@keyframes dots {
            0%, 20% {
                content: '.';
            }

            40% {
                content: '..';
            }

            60%, 100% {
                content: '...';
            }
        }

        .signin-dots::after {
            content: '';
            animation: dots 1.5s steps(4, end) infinite;
        }

        .modal-overlay.active {
            display: flex;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 20px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
            animation: scaleIn 0.3s ease;
            position: relative;
        }

        @@keyframes scaleIn {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .modal-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

            .modal-icon i {
                font-size: 40px;
                color: #10b981;
            }

        .modal-title {
            font-size: 24px;
            font-weight: 700;
            color: #065f46;
            margin-bottom: 12px;
        }

        .modal-message {
            font-size: 16px;
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .modal-close-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 14px 32px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .modal-close-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
            }

        @@media (max-width: 480px) {
            .otp-container {
                padding: 36px 28px;
            }

            .otp-digit {
                width: 48px;
                height: 56px;
                font-size: 24px;
            }

            .modal-content {
                padding: 32px 24px;
            }
        }
    </style>
</head>
<body>
    <!-- Sign In Loading Overlay -->
    <div class="signin-overlay" id="signinOverlay">
        <div class="signin-content">
            <div class="signin-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2 class="signin-title">Signing in<span class="signin-dots"></span></h2>
            <p class="signin-message">Welcome, <strong id="userName">User</strong>!</p>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal-overlay" id="successModal">
        <div class="modal-content">
            <div class="modal-icon">
                <i class="fas fa-paper-plane"></i>
            </div>
            <h2 class="modal-title">OTP Resent Successfully!</h2>
            <p class="modal-message">OTP has been resent to your email again, please do check it!</p>
            <button class="modal-close-btn" onclick="closeModal()">Got it!</button>
        </div>
    </div>

    <div class="otp-container">
        <div class="icon-circle">
            <i class="fas fa-shield-halved"></i>
        </div>

        <h1 class="welcome-text">Verify Your Identity</h1>
        <p class="subtitle">We've sent a 6-digit verification code to your email address</p>

        <div class="email-display">
            <i class="fas fa-envelope"></i>
            <strong>@Model.Email</strong>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        @using (Html.BeginForm("VerifyOtp", "Account", FormMethod.Post, new { id = "otpForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Email)

            <div class="otp-input-wrapper">
                <input type="text" class="otp-digit" id="digit1" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-digit" id="digit2" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-digit" id="digit3" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-digit" id="digit4" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-digit" id="digit5" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-digit" id="digit6" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
            </div>

            @Html.TextBoxFor(m => m.OtpCode, new { @class = "hidden-input", id = "otpCodeInput" })
            @Html.ValidationMessageFor(m => m.OtpCode, "", new { @class = "field-validation-error", style = "text-align: center; display: block;" })

            <div class="timer-box">
                <i class="fas fa-clock"></i>
                <span class="timer-text">Code expires in: <span class="countdown" id="timer">5:00</span></span>
            </div>

            <button type="submit" class="btn-verify" id="verifyBtn">
                <i class="fas fa-check-circle"></i> Verify OTP
            </button>
        }

        <div class="resend-section">
            <p class="resend-text">Didn't receive the code?</p>
            @using (Html.BeginForm("ResendOtp", "Account", FormMethod.Post, new { id = "resendForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email">
                <button type="button" class="btn-resend" id="resendBtn" onclick="handleResendOtp(event)">
                    <i class="fas fa-rotate"></i> <span id="resendBtnText">Resend OTP</span>
                </button>
            }
        </div>

        <div class="back-login">
            <a href="@Url.Action("Login", "Account")">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
        </div>

        <div class="security-note">
            <i class="fas fa-lock"></i>
            <strong>Security Tip:</strong> Never share your OTP code with anyone, including FurEver Home staff.
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>


    <script type="text/javascript">
(function() {
    'use strict';

    let isCheckingSession = false;
    let redirecting = false;

    // Check session immediately and synchronously
    function checkSessionSync() {
        if (isCheckingSession || redirecting) return;

        isCheckingSession = true;

        fetch('@Url.Action("CheckSession", "Account")', {
            method: 'GET',
            cache: 'no-cache',
            headers: {
                'Cache-Control': 'no-cache',
                'Pragma': 'no-cache'
            }
        }).then(response => {
            if (response.ok && !redirecting) {
                // Already logged in - redirect immediately
                redirecting = true;
                const userRole = '@(Session["UserRole"] ?? "")';

                // ✅ UPDATED: Check if NOT a client
                const redirectUrl = (userRole !== 'Client')
                    ? '@Url.Action("Dashboard", "Admin")'
                    : '@Url.Action("Index", "Pets")';

                window.location.replace(redirectUrl);
            } else {
                isCheckingSession = false;
            }
        }).catch(() => {
            isCheckingSession = false;
        });
    }

    // Check on page load
    checkSessionSync();

    // Aggressive back button prevention
    let historyLocked = false;

    function lockHistory() {
        if (redirecting) return;

        historyLocked = true;

        // Push multiple dummy states
        for (let i = 0; i < 5; i++) {
            window.history.pushState(
                { page: 'verify-otp', index: i, locked: true },
                '',
                window.location.href
            );
        }
    }

    // Lock immediately
    lockHistory();

    // Handle ALL popstate events
    window.addEventListener('popstate', function(event) {
        if (redirecting) return;

        // Immediately push forward
        window.history.pushState(
            { page: 'verify-otp', locked: true },
            '',
            window.location.href
        );

        // Re-lock
        setTimeout(lockHistory, 10);

        // Check session on back attempt
        if (!isCheckingSession) {
            checkSessionSync();
        }

        // Prevent default
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        return false;
    }, true);

    // Prevent keyboard back navigation
    document.addEventListener('keydown', function(e) {
        if (redirecting) return;

        // Alt + Left Arrow
        if (e.altKey && (e.keyCode === 37 || e.key === 'ArrowLeft')) {
            e.preventDefault();
            e.stopImmediatePropagation();
            return false;
        }

        // Backspace (except in inputs)
        if (e.keyCode === 8 || e.key === 'Backspace') {
            const element = e.target;
            const isInput = element.tagName === 'INPUT' ||
                          element.tagName === 'TEXTAREA' ||
                          element.isContentEditable;

            if (!isInput) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }
        }
    }, true);

    // Handle page visibility
    document.addEventListener('visibilitychange', function() {
        if (!document.hidden && !redirecting) {
            checkSessionSync();
            lockHistory();
        }
    });

    // Handle page show from cache
    window.addEventListener('pageshow', function(event) {
        if (event.persisted && !redirecting) {
            checkSessionSync();
            lockHistory();
        }
    });

    // Periodic session check every 5 seconds (more frequent for OTP page)
    setInterval(function() {
        if (!redirecting) {
            checkSessionSync();
        }
    }, 5000);

    console.log('🔒 VerifyOTP: Back button disabled');

        })();
    </script>

    <script type="text/javascript">
    // OTP Input Handler
    const otpInputs = document.querySelectorAll('.otp-digit');
    const hiddenInput = document.getElementById('otpCodeInput');
    const verifyBtn = document.getElementById('verifyBtn');

    // Focus first input on load
    otpInputs[0].focus();

    otpInputs.forEach((input, index) => {
        input.addEventListener('input', function (e) {
            // Only allow numbers
            this.value = this.value.replace(/[^0-9]/g, '');

            if (this.value.length === 1) {
                this.classList.add('filled');
                // Move to next input
                if (index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
            } else {
                this.classList.remove('filled');
            }

            // Update hidden input
            updateOtpValue();
        });

        input.addEventListener('keydown', function (e) {
            // Handle backspace
            if (e.key === 'Backspace' && this.value === '' && index > 0) {
                otpInputs[index - 1].focus();
                otpInputs[index - 1].value = '';
                otpInputs[index - 1].classList.remove('filled');
                updateOtpValue();
            }

            // Handle arrow keys
            if (e.key === 'ArrowLeft' && index > 0) {
                otpInputs[index - 1].focus();
            }
            if (e.key === 'ArrowRight' && index < otpInputs.length - 1) {
                otpInputs[index + 1].focus();
            }
        });

        // Handle paste
        input.addEventListener('paste', function (e) {
            e.preventDefault();
            const pastedData = e.clipboardData.getData('text').replace(/[^0-9]/g, '');

            if (pastedData.length === 6) {
                otpInputs.forEach((inp, idx) => {
                    inp.value = pastedData[idx] || '';
                    if (inp.value) inp.classList.add('filled');
                });
                otpInputs[5].focus();
                updateOtpValue();
            }
        });
    });

    function updateOtpValue() {
        const otpValue = Array.from(otpInputs).map(input => input.value).join('');
        hiddenInput.value = otpValue;

        // Enable/disable verify button
        if (otpValue.length === 6) {
            verifyBtn.disabled = false;
        } else {
            verifyBtn.disabled = true;
        }
    }

    // Countdown Timer
    let timeLeft = 300; // 5 minutes in seconds
    const timerElement = document.getElementById('timer');
    const resendBtn = document.getElementById('resendBtn');

    const countdown = setInterval(function () {
        timeLeft--;

        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        timerElement.textContent = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;

        if (timeLeft <= 0) {
            clearInterval(countdown);
            timerElement.textContent = 'EXPIRED';
            timerElement.style.color = '#ef4444';
            verifyBtn.disabled = true;
            verifyBtn.innerHTML = '<i class="fas fa-clock"></i> OTP Expired';
            resendBtn.disabled = false;
        }

        // Change color when time is running out
        if (timeLeft <= 60) {
            timerElement.style.color = '#ef4444';
        } else if (timeLeft <= 120) {
            timerElement.style.color = '#f59e0b';
        }
    }, 1000);

    // Auto-submit when OTP is complete
    document.getElementById('otpForm').addEventListener('submit', function(e) {
        if (hiddenInput.value.length !== 6) {
            e.preventDefault();
            alert('Please enter all 6 digits of the OTP code.');
            return;
        }

        // Show signing in animation
        e.preventDefault();
        showSignInAnimation();

        // Get username from ViewBag
        const username = '@Html.Raw(userName)';
        document.getElementById('userName').textContent = username;

        // Submit form after 3 seconds
        setTimeout(function() {
            e.target.submit();
        }, 3000);
    });

    // Show Sign In Animation
    function showSignInAnimation() {
        document.getElementById('signinOverlay').classList.add('active');
    }

    // Modal Functions
    function closeModal() {
        document.getElementById('successModal').classList.remove('active');
    }

    function showModal() {
        document.getElementById('successModal').classList.add('active');
    }

    // Click outside modal to close
    document.getElementById('successModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeModal();
        }
    });

    // Resend OTP Handler with 60-second cooldown
    let resendCooldown = 0;
    let resendInterval = null;

    function handleResendOtp(event) {
        event.preventDefault();

        if (resendCooldown > 0) {
            return; // Still in cooldown
        }

        // Submit the form via AJAX or regular form submit
        const form = document.getElementById('resendForm');
        const formData = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (response.ok) {
                // Show success modal
                showModal();

                // Start 60-second cooldown
                startResendCooldown();
            }
            return response;
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to resend OTP. Please try again.');
        });
    }

    function startResendCooldown() {
        resendCooldown = 60;
        resendBtn.disabled = true;

        resendInterval = setInterval(function() {
            resendCooldown--;
            document.getElementById('resendBtnText').textContent = `Resend OTP (${resendCooldown}s)`;

            if (resendCooldown <= 0) {
                clearInterval(resendInterval);
                resendBtn.disabled = false;
                document.getElementById('resendBtnText').textContent = 'Resend OTP';
            }
        }, 1000);
    }
    </script>


</body>
</html>