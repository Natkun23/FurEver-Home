@model FurEver_Home.Models.AdoptionApplication
@{
    ViewBag.Title = "Apply for Adoption - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .application-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .app-header {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            padding: 40px;
            color: white;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .pet-preview {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            object-fit: cover;
            border: 5px solid white;
        }

        .app-header-text h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .app-header-text p {
            opacity: 0.9;
            font-size: 1.1em;
        }

        .app-body {
            padding: 40px;
        }

        .section-title {
            font-size: 1.5em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 14px 16px;
                border: 2px solid #e2e8f0;
                border-radius: 12px;
                font-size: 15px;
                transition: all 0.3s;
                outline: none;
                background: #f8fafc;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: #3FA9F5;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
                }

            .form-group textarea {
                min-height: 120px;
                resize: vertical;
            }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .radio-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .radio-option:hover {
                border-color: #3FA9F5;
                background: #eff6ff;
            }

            .radio-option input[type="radio"]:checked + label {
                color: #3FA9F5;
                font-weight: 600;
            }

        .info-box {
            background: #eff6ff;
            border-left: 4px solid #3FA9F5;
            padding: 20px;
            border-radius: 10px;
            margin: 30px 0;
        }

            .info-box h4 {
                color: #1e40af;
                margin-bottom: 10px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .info-box ul {
                margin-left: 20px;
                color: #334155;
                line-height: 1.8;
            }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
            }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="application-card">
            <div class="app-header">
                <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/120?text=Pet" : Model.Pet.ImageUrl)" alt="@Model.Pet.Name" class="pet-preview">
                <div class="app-header-text">
                    <h1>Adopt @Model.Pet.Name</h1>
                    <p><i class="fas fa-paw"></i> @Model.Pet.Breed • @Model.Pet.Age year@(Model.Pet.Age > 1 ? "s" : "") • @Model.Pet.Gender</p>
                </div>
            </div>

            <div class="app-body">
                <div class="section-title">
                    <i class="fas fa-clipboard-list"></i>
                    Adoption Application
                </div>

                @using (Html.BeginForm("Apply", "Pets", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.PetId)

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Phone Number *</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { placeholder = "Your contact number", required = "required" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group">
                            <label>Housing Type *</label>
                            @Html.DropDownListFor(m => m.HousingType,
                                new SelectList(new[] { "House", "Apartment", "Condo", "Townhouse" }),
                                "-- Select Housing Type --",
                                new { required = "required" })
                            @Html.ValidationMessageFor(m => m.HousingType, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Complete Address *</label>
                        @Html.TextAreaFor(m => m.Address, new { placeholder = "Your full address", rows = "3", required = "required" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Do you currently have other pets? *</label>
                        <div class="radio-group">
                            <div class="radio-option">
                                @Html.RadioButtonFor(m => m.HasPets, "Yes", new { id = "hasYes" })
                                <label for="hasYes">Yes</label>
                            </div>
                            <div class="radio-option">
                                @Html.RadioButtonFor(m => m.HasPets, "No", new { id = "hasNo", @checked = "checked" })
                                <label for="hasNo">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Why do you want to adopt @Model.Pet.Name? *</label>
                        @Html.TextAreaFor(m => m.Message, new { placeholder = "Tell us why you'd be a great pet parent...", rows = "5", required = "required" })
                        @Html.ValidationMessageFor(m => m.Message, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="info-box">
                        <h4><i class="fas fa-info-circle"></i> What happens next?</h4>
                        <ul>
                            <li>Our admin team will review your application within 24-48 hours</li>
                            <li>We'll contact you to schedule a meet-and-greet with @Model.Pet.Name</li>
                            <li>If approved, we'll arrange the adoption process</li>
                            <li>You'll receive post-adoption support and guidance</li>
                        </ul>
                    </div>

                    <div class="action-buttons">
                        <a href="@Url.Action("Details", "Pets", new { id = Model.PetId })" class="btn btn-back">
                            <i class="fas fa-arrow-left"></i> Back to Pet Details
                        </a>
                        <button type="submit" class="btn btn-submit">
                            <i class="fas fa-paper-plane"></i> Submit Application
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>