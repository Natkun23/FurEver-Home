@model FurEver_Home.Models.AdoptionApplication
@{
    ViewBag.Title = "Apply for Adoption - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .application-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .app-header {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            padding: 40px;
            color: white;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .pet-preview {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            object-fit: cover;
            border: 5px solid white;
        }

        .app-header-text h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .app-header-text p {
            opacity: 0.9;
            font-size: 1.1em;
        }

        .app-body {
            padding: 40px;
        }

        .section-title {
            font-size: 1.5em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 15px;
            border-bottom: 3px solid #E8F4FC;
        }

        .section-description {
            background: #FFF9E6;
            border-left: 4px solid #FFD93D;
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            color: #92400e;
            font-size: 0.95em;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            color: #334155;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .form-group .required {
            color: #ef4444;
            margin-left: 3px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
            background: #f8fafc;
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #3FA9F5;
            background: white;
            box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        .radio-group {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }

        .radio-option {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            background: #f8fafc;
        }

        .radio-option:hover {
            border-color: #3FA9F5;
            background: #eff6ff;
        }

        .radio-option input[type="radio"] {
            width: auto;
            margin: 0;
        }

        .radio-option:has(input[type="radio"]:checked) {
            border-color: #3FA9F5;
            background: #eff6ff;
        }

        .radio-option label {
            margin: 0;
            cursor: pointer;
            flex: 1;
        }

        .info-box {
            background: #eff6ff;
            border-left: 4px solid #3FA9F5;
            padding: 20px;
            border-radius: 10px;
            margin: 30px 0;
        }

        .info-box h4 {
            color: #1e40af;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .info-box ul {
            margin-left: 20px;
            color: #334155;
            line-height: 1.8;
        }

        .screening-section {
            background: #f8f9fa;
            padding: 30px;
            border-radius: 15px;
            margin: 30px 0;
        }

        .question-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            background: #3FA9F5;
            color: white;
            border-radius: 50%;
            font-weight: 700;
            font-size: 0.9em;
            margin-right: 10px;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
            display: block;
        }

        .step-indicator {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
            padding: 20px;
            background: #f8fafc;
            border-radius: 12px;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: white;
            border-radius: 8px;
            font-weight: 600;
            color: #64748b;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .step.active {
            background: #3FA9F5;
            color: white;
        }

        .step i {
            font-size: 1.2em;
        }

        /* Warning Banner */
        .warning-banner {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            padding: 18px 20px;
            border-radius: 12px;
            border-left: 4px solid #f59e0b;
            margin: 20px 0;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #92400e;
        }

        .warning-banner i {
            font-size: 1.5em;
            color: #d97706;
        }

        /* Agreement Modal Styles */
        .agreement-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 10000;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s;
        }

        .agreement-modal-content {
            background: white;
            border-radius: 25px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideUp 0.4s;
        }

        .agreement-header {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            padding: 30px;
            text-align: center;
            color: white;
            border-radius: 25px 25px 0 0;
        }

        .agreement-header i {
            font-size: 4em;
            margin-bottom: 15px;
            display: block;
            animation: pulse 2s infinite;
        }

        .agreement-header h2 {
            margin: 0;
            font-size: 1.8em;
            font-weight: 700;
        }

        .agreement-body {
            padding: 35px;
        }

        .policy-notice {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            padding: 20px;
            border-radius: 15px;
            border-left: 4px solid #dc2626;
            margin-bottom: 25px;
        }

        .policy-notice h4 {
            color: #991b1b;
            margin-bottom: 12px;
            font-size: 1.1em;
        }

        .policy-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .policy-list li {
            color: #7f1d1d;
            padding: 10px 0 10px 35px;
            position: relative;
            line-height: 1.6;
            font-size: 0.95em;
        }

        .policy-list li:before {
            content: "⚠";
            position: absolute;
            left: 0;
            color: #dc2626;
            font-size: 1.3em;
            font-weight: bold;
        }

        .policy-list li strong {
            color: #991b1b;
        }

        .agreement-checkbox-wrapper {
            background: #f8fafc;
            padding: 20px;
            border-radius: 15px;
            border: 2px solid #e2e8f0;
            margin: 25px 0;
            cursor: pointer;
            transition: all 0.3s;
        }

        .agreement-checkbox-wrapper:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }

        .agreement-checkbox-wrapper.checked {
            background: #d1fae5;
            border-color: #10b981;
        }

        .checkbox-container {
            display: flex;
            align-items: start;
            gap: 15px;
        }

        .custom-checkbox {
            width: 28px;
            height: 28px;
            min-width: 28px;
            border: 3px solid #cbd5e1;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            background: white;
        }

        .custom-checkbox.checked {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border-color: #10b981;
        }

        .custom-checkbox i {
            color: white;
            font-size: 1.2em;
            display: none;
        }

        .custom-checkbox.checked i {
            display: block;
        }

        .checkbox-label {
            color: #334155;
            font-size: 1em;
            line-height: 1.6;
            cursor: pointer;
            user-select: none;
        }

        .checkbox-label strong {
            color: #2E8BC0;
            font-size: 1.05em;
        }

        .agreement-buttons {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .btn-modal {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-modal-cancel {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-modal-cancel:hover {
            background: #cbd5e1;
        }

        .btn-modal-agree {
            background: #cbd5e1;
            color: #94a3b8;
            cursor: not-allowed;
            position: relative;
            overflow: hidden;
        }

        .btn-modal-agree.enabled {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            cursor: pointer;
        }

        .btn-modal-agree.enabled:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .btn-submit {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            color: white;
            padding: 16px 50px;
            border: none;
            border-radius: 12px;
            font-size: 1.1em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(63, 169, 245, 0.4);
        }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
            padding: 12px 30px;
            border: none;
            border-radius: 12px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back:hover {
            background: #cbd5e1;
            transform: translateY(-2px);
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
            margin-top: 30px;
        }

        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .app-header {
                flex-direction: column;
                text-align: center;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-back,
            .btn-submit {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="application-card">
            <div class="app-header">
                <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/120?text=Pet" : Model.Pet.ImageUrl)" alt="@Model.Pet.Name" class="pet-preview">
                <div class="app-header-text">
                    <h1>Adopt @Model.Pet.Name</h1>
                    <p><i class="fas fa-paw"></i> @Model.Pet.Breed • @Model.Pet.AgeDisplay • @Model.Pet.Gender</p>
                </div>
            </div>

            <div class="app-body">
                <div class="step-indicator">
                    <div class="step active">
                        <i class="fas fa-user"></i>
                        <span>Basic Info</span>
                    </div>
                    <div class="step active">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Screening</span>
                    </div>
                    <div class="step">
                        <i class="fas fa-paper-plane"></i>
                        <span>Submit</span>
                    </div>
                </div>

                @using (Html.BeginForm("Apply", "Pets", FormMethod.Post, new { id = "applyForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.PetId)

                    <!-- SECTION 1: BASIC INFORMATION -->
                    <div class="section-title">
                        <i class="fas fa-user-circle"></i>
                        Basic Information
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Phone Number <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { placeholder = "Your contact number", required = "required" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group">
                            <label>Housing Type <span class="required">*</span></label>
                            @Html.DropDownListFor(m => m.HousingType,
                                new SelectList(new[] { "House", "Apartment", "Condo", "Townhouse" }),
                                "-- Select Housing Type --",
                                new { required = "required" })
                            @Html.ValidationMessageFor(m => m.HousingType, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Complete Address <span class="required">*</span></label>
                        @Html.TextAreaFor(m => m.Address, new { placeholder = "Your full address", rows = "3", required = "required" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Do you currently have other pets? <span class="required">*</span></label>
                        <div class="radio-group">
                            <div class="radio-option">
                                @Html.RadioButtonFor(m => m.HasPets, "Yes", new { id = "hasYes" })
                                <label for="hasYes">Yes</label>
                            </div>
                            <div class="radio-option">
                                @Html.RadioButtonFor(m => m.HasPets, "No", new { id = "hasNo", @checked = "checked" })
                                <label for="hasNo">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Why do you want to adopt @Model.Pet.Name? <span class="required">*</span></label>
                        @Html.TextAreaFor(m => m.Message, new { placeholder = "Tell us why you'd be a great pet parent...", rows = "4", required = "required" })
                        @Html.ValidationMessageFor(m => m.Message, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- SECTION 2: SCREENING QUESTIONS -->
                    <div class="section-title" style="margin-top: 40px;">
                        <i class="fas fa-clipboard-check"></i>
                        Adoption Capability Screening
                    </div>

                    <div class="section-description">
                        <strong><i class="fas fa-info-circle"></i> Important:</strong> Please answer these questions honestly. They help us ensure the best match between you and @Model.Pet.Name.
                    </div>

                    <div class="screening-section">
                        <div class="form-group full-width">
                            <label>
                                <span class="question-number">1</span>
                                Do you have prior experience caring for pets? Please describe your experience. <span class="required">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.ScreeningQ1Experience, new
                            {
                                placeholder = "Describe your experience with pets (e.g., owned dogs/cats before, volunteered at shelters, etc.)",
                                rows = "4",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.ScreeningQ1Experience, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group full-width">
                            <label>
                                <span class="question-number">2</span>
                                Can you financially commit to pet expenses including food, veterinary care, and emergencies? <span class="required">*</span>
                            </label>
                            <div class="radio-group">
                                <div class="radio-option">
                                    @Html.RadioButtonFor(m => m.ScreeningQ2Financial, "Yes", new { id = "financialYes", required = "required" })
                                    <label for="financialYes">Yes</label>
                                </div>
                                <div class="radio-option">
                                    @Html.RadioButtonFor(m => m.ScreeningQ2Financial, "No", new { id = "financialNo" })
                                    <label for="financialNo">No</label>
                                </div>
                            </div>
                            <div style="margin-top: 15px;">
                                @Html.TextAreaFor(m => m.ScreeningQ2Explanation, new
                                {
                                    placeholder = "Please explain your financial readiness (e.g., stable income, pet insurance, emergency savings)",
                                    rows = "3",
                                    required = "required"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.ScreeningQ2Financial, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group full-width">
                            <label>
                                <span class="question-number">3</span>
                                Do all household members agree to this adoption? <span class="required">*</span>
                            </label>
                            <div class="radio-group">
                                <div class="radio-option">
                                    @Html.RadioButtonFor(m => m.ScreeningQ3HouseholdAgreement, "Yes", new { id = "householdYes", required = "required" })
                                    <label for="householdYes">Yes</label>
                                </div>
                                <div class="radio-option">
                                    @Html.RadioButtonFor(m => m.ScreeningQ3HouseholdAgreement, "No", new { id = "householdNo" })
                                    <label for="householdNo">No</label>
                                </div>
                            </div>
                            <div style="margin-top: 15px;">
                                @Html.TextAreaFor(m => m.ScreeningQ3Explanation, new
                                {
                                    placeholder = "Explain household support (e.g., all family members are excited, no allergies, everyone committed to care)",
                                    rows = "3",
                                    required = "required"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.ScreeningQ3HouseholdAgreement, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group full-width">
                            <label>
                                <span class="question-number">4</span>
                                What is your plan for the pet if you need to move or travel? <span class="required">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.ScreeningQ4RelocationPlan, new
                            {
                                placeholder = "Describe your contingency plans (e.g., pet-friendly housing, trusted pet sitters, no plans to relocate soon)",
                                rows = "4",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.ScreeningQ4RelocationPlan, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="form-group full-width">
                            <label>
                                <span class="question-number">5</span>
                                How many hours per day will the pet be left alone? <span class="required">*</span>
                            </label>
                            @Html.DropDownListFor(m => m.ScreeningQ5HoursAlone,
                                new SelectList(new[] {
                                    "Less than 4 hours",
                                    "4-6 hours",
                                    "6-8 hours",
                                    "More than 8 hours"
                                }),
                                "-- Select Average Hours --",
                                new { required = "required" })
                            @Html.ValidationMessageFor(m => m.ScreeningQ5HoursAlone, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="info-box">
                        <h4><i class="fas fa-info-circle"></i> What happens next?</h4>
                        <ul>
                            <li>Our admin team will review your application and screening answers within 24-48 hours</li>
                            <li>We'll evaluate your capability to provide a loving and stable home for @Model.Pet.Name</li>
                            <li>If approved, we'll contact you to schedule a meet-and-greet</li>
                            <li>You'll receive post-adoption support and guidance</li>
                        </ul>
                    </div>

                    <!-- Warning Banner -->
                    <div class="warning-banner">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <strong>Please Note:</strong> Once approved by admin, adoptions cannot be cancelled.
                            Click Submit to review the full policy.
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="action-buttons">
                        <a href="@Url.Action("Index", "Pets")" class="btn-back">
                            <i class="fas fa-arrow-left"></i> Back to Pets
                        </a>
                        <button type="button" class="btn-submit" onclick="showAgreementModal()">
                            <i class="fas fa-paper-plane"></i> Submit Application
                        </button>
                    </div>
                }

                <!-- Agreement Modal -->
                <div id="agreementModal" class="agreement-modal">
                    <div class="agreement-modal-content">
                        <div class="agreement-header">
                            <i class="fas fa-exclamation-triangle"></i>
                            <h2>Important Adoption Policy</h2>
                        </div>

                        <div class="agreement-body">
                            <div class="policy-notice">
                                <h4>⚠️ Please Read Carefully Before Proceeding</h4>
                                <p style="color: #7f1d1d; margin-bottom: 15px;">
                                    By submitting this application, you are making a commitment to adopt this pet if approved by our team.
                                </p>
                                <ul class="policy-list">
                                    <li>
                                        <strong>Once approved by admin, adoptions CANNOT be cancelled.</strong>
                                    </li>
                                    <li>
                                        You can only withdraw your application <u>before</u> admin approval.
                                    </li>
                                    <li>
                                        After approval, pickup details will be set and you <strong>must proceed</strong> with the adoption.
                                    </li>
                                    <li>
                                        This policy ensures our pets find committed, loving homes.
                                    </li>
                                    <li>
                                        Please ensure you are <strong>fully ready and committed</strong> before applying.
                                    </li>
                                </ul>
                            </div>

                            <div class="agreement-checkbox-wrapper" id="agreementCheckboxWrapper" onclick="toggleAgreement()">
                                <div class="checkbox-container">
                                    <div class="custom-checkbox" id="customCheckbox">
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <label class="checkbox-label">
                                        <strong>I understand and agree to the FurEver Home adoption policy.</strong>
                                        <br>
                                        I acknowledge that once my application is approved by admin, I cannot cancel or withdraw from this adoption. I am fully committed to providing a loving home for this pet.
                                    </label>
                                </div>
                            </div>

                            <div class="agreement-buttons">
                                <button type="button" class="btn-modal btn-modal-cancel" onclick="closeAgreementModal()">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                                <button type="button" class="btn-modal btn-modal-agree" id="btnAgree" disabled onclick="submitApplicationForm()">
                                    <i class="fas fa-lock"></i> Agree & Submit Application
                                </button>
                            </div>

                            <p style="text-align: center; color: #94a3b8; font-size: 0.9em; margin-top: 15px;">
                                <i class="fas fa-shield-alt"></i> Your commitment helps us protect our animals
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        let isAgreed = false;

        function showAgreementModal() {
            // Reset checkbox state
            isAgreed = false;
            updateCheckboxUI();
            document.getElementById('agreementModal').style.display = 'flex';
        }

        function closeAgreementModal() {
            document.getElementById('agreementModal').style.display = 'none';
        }

        function toggleAgreement() {
            isAgreed = !isAgreed;
            updateCheckboxUI();
        }

        function updateCheckboxUI() {
            const checkbox = document.getElementById('customCheckbox');
            const wrapper = document.getElementById('agreementCheckboxWrapper');
            const btnAgree = document.getElementById('btnAgree');

            if (isAgreed) {
                checkbox.classList.add('checked');
                wrapper.classList.add('checked');
                btnAgree.classList.add('enabled');
                btnAgree.disabled = false;
                btnAgree.innerHTML = '<i class="fas fa-check-circle"></i> Agree & Submit Application';
            } else {
                checkbox.classList.remove('checked');
                wrapper.classList.remove('checked');
                btnAgree.classList.remove('enabled');
                btnAgree.disabled = true;
                btnAgree.innerHTML = '<i class="fas fa-lock"></i> Agree & Submit Application';
            }
        }

        function submitApplicationForm() {
            if (isAgreed) {
                // Close modal
                closeAgreementModal();

                // Submit the actual form
                document.getElementById('applyForm').submit();
            }
        }

        // Close modal when clicking outside
        window.onclick = function (event) {
            const modal = document.getElementById('agreementModal');
            if (event.target === modal) {
                closeAgreementModal();
            }
        }
    </script>
</body>
</html>