                        const petLocation = ($card.attr('data-location') || '').toLowerCase();

                        let show = true;

                        if (searchTerm && name.indexOf(searchTerm) === -1) show = false;
                        if (gender && petGender !== gender) show = false;
                        if (size && petSize !== size) show = false;
                        if (location && petLocation.indexOf(location) === -1) show = false;

                        if (ageRange) {
                            const [min, max] = ageRange.split('-').map(Number);
                            if (petAge < min || petAge > max) show = false;
                        }

                        if (show) {
