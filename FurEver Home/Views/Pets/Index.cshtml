                    </div>
                }
                else if (firstNotif.NotificationType == "Application_Rejected")
                {
                    <div style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 30px; text-align: center; color: white;">
                        <div style="font-size: 4em; margin-bottom: 15px;">😔</div>
                        <h2 style="margin: 0; font-size: 1.8em; font-weight: 700;">Application Update</h2>
                    </div>
                }
                else if (firstNotif.NotificationType == "ID_Verified")
                {
                    <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); padding: 30px; text-align: center; color: white;">
                        <div style="font-size: 4em; margin-bottom: 15px;">✅</div>
                        <h2 style="margin: 0; font-size: 1.8em; font-weight: 700;">ID Verified!</h2>
                    </div>
                }
                else if (firstNotif.NotificationType == "Pickup_Ready")
                {
                    <div style="background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%); padding: 30px; text-align: center; color: #2E8BC0;">
                        <div style="font-size: 4em; margin-bottom: 15px;">🐾</div>
                        <h2 style="margin: 0; font-size: 1.8em; font-weight: 700;">Pet Ready for Pickup!</h2>
                    </div>
                }
                else
                {
                    <div style="background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%); padding: 30px; text-align: center; color: white;">
                        <div style="font-size: 4em; margin-bottom: 15px;">🔔</div>
                        <h2 style="margin: 0; font-size: 1.8em; font-weight: 700;">New Notification</h2>
                    </div>
                }

                <div style="padding: 30px;">
                    <div style="font-size: 1.2em; color: #334155; line-height: 1.6; margin-bottom: 20px; text-align: center;">
                        @firstNotif.Message
                    </div>

                    <div style="text-align: center; color: #94a3b8; font-size: 0.9em; margin-bottom: 25px;">
                        <i class="fas fa-clock"></i> @firstNotif.CreatedAt.ToString("MMMM dd, yyyy h:mm tt")
                    </div>

                    <div style="display: flex; gap: 12px;">
                        <button onclick="closeAutoPopup()" style="flex: 1; padding: 14px; background: #e2e8f0; color: #334155; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; font-size: 1em; transition: all 0.3s;">
                            Close
                        </button>
                        <button onclick="markAsReadAndRedirect(@firstNotif.NotificationId, '@firstNotif.NotificationType')" style="flex: 1; padding: 14px; background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%); color: white; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; font-size: 1em; transition: all 0.3s;">
                            View Details
                        </button>
                    </div>

                    @if (ViewBag.UnreadNotifications.Count > 1)
                    {
                        <div style="text-align: center; margin-top: 15px; color: #64748b; font-size: 0.9em;">
                            + @(ViewBag.UnreadNotifications.Count - 1) more notification@(ViewBag.UnreadNotifications.Count > 2 ? "s" : "")
                        </div>
                    }
                </div>
            </div>
        </div>
    }




    <!-- PART 3: Update JavaScript (Replace the notification functions) -->

    <script>
    // ========== NOTIFICATION FUNCTIONALITY ==========
        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) {
                dropdown.style.display = dropdown.style.display === 'none' || dropdown.style.display === '' ? 'block' : 'none';
            }
        }

    // Handle notification click with redirection (for dropdown)
function handleNotificationClick(notificationId, notificationType) {
    // Mark as read first
    fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ id: notificationId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Redirect based on notification type
            redirectBasedOnType(notificationType);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        // Redirect anyway even if marking as read fails
        redirectBasedOnType(notificationType);
    });
}


     // Redirect based on notification type
function redirectBasedOnType(notificationType) {
    switch(notificationType) {
        case 'Application_Approved':
        case 'Application_Rejected':
        case 'Application_Pending_Pickup':
            // Redirect to My Applications page
            window.location.href = '@Url.Action("MyApplications", "Pets")';
            break;

        case 'Pickup_Ready':
            // Redirect to My Applications page
            window.location.href = '@Url.Action("MyApplications", "Pets")';
            break;

        case 'ID_Verified':
            // Redirect to Profile page
            window.location.href = '@Url.Action("Profile", "Account")';
            break;

        default:
            // Reload the page to update notification count
            location.reload();
            break;
    }
}


        // Close popup without marking as read
        function closeAutoPopup() {
            const popup = document.getElementById('autoNotificationPopup');
            if (popup) {
                popup.style.animation = 'fadeOut 0.3s';
                setTimeout(function () {
                    popup.style.display = 'none';
                }, 300);
            }
        }


   // Mark as read and redirect from popup
function markAsReadAndRedirect(notificationId, notificationType) {
    fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ id: notificationId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            closeAutoPopup();
            // Redirect based on notification type
            redirectBasedOnType(notificationType);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        closeAutoPopup();
        redirectBasedOnType(notificationType);
    });
}

        // Auto-close notification popup after 15 seconds
        setTimeout(function () {
            const popup = document.getElementById('autoNotificationPopup');
            if (popup && popup.style.display !== 'none') {
                closeAutoPopup();
            }
        }, 15000);

        // Close notification dropdown when clicking outside
        document.addEventListener('click', function (event) {
            const bell = event.target.closest('.notification-bell');
            const dropdown = document.getElementById('notificationDropdown');

            if (!bell && dropdown) {
                dropdown.style.display = 'none';
            }
        });

    // ========== REST OF YOUR JAVASCRIPT ==========
    // (Keep all other existing JavaScript functions below)
    </script>

