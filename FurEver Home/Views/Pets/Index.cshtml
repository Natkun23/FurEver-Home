                            $card.fadeOut(300);
                        }
                    });

                    $('#resultsCount').text(visibleCount);
                    updateActiveFilters();

                    // ⭐ SAVE FILTERS TO URL
                    saveFiltersToURL();
                }

                // ⭐ NEW: Save current filters to URL
                function saveFiltersToURL() {
                    const params = new URLSearchParams();

                    const search = searchInput.val().trim();
                    const gender = genderFilter.val();
                    const size = sizeFilter.val();
                    const age = ageFilter.val();
                    const location = locationFilter.val().trim();
                    const sort = sortSelect.val();

                    if (search) params.set('search', search);
                    if (gender) params.set('gender', gender);
                    if (size) params.set('size', size);
                    if (age) params.set('age', age);
                    if (location) params.set('location', location);
                    if (sort && sort !== 'newest') params.set('sort', sort);

                    // Update URL without page reload
                    const newURL = params.toString()
                        ? window.location.pathname + '?' + params.toString()
                        : window.location.pathname;

                    window.history.replaceState({}, '', newURL);
                }

                // ⭐ NEW: Load filters from URL on page load
                function loadFiltersFromURL() {
                    const params = new URLSearchParams(window.location.search);

                    const search = params.get('search');
                    const gender = params.get('gender');
                    const size = params.get('size');
                    const age = params.get('age');
                    const location = params.get('location');
                    const sort = params.get('sort');

                    if (search) searchInput.val(search);
                    if (gender) genderFilter.val(gender);
                    if (size) sizeFilter.val(size);
                    if (age) ageFilter.val(age);
                    if (location) locationFilter.val(location);
                    if (sort) sortSelect.val(sort);

                    // Apply filters after loading
                    filterPets();
                }

                // Attach filter events
                searchInput.on('keyup', filterPets);
                locationFilter.on('keyup', filterPets);
                genderFilter.on('change', filterPets);
                sizeFilter.on('change', filterPets);
                ageFilter.on('change', filterPets);
                sortSelect.on('change', filterPets);

                window.resetFilters = function () {
                    searchInput.val('');
                    genderFilter.val('');
                    sizeFilter.val('');
                    ageFilter.val('');
                    locationFilter.val('');
                    sortSelect.val('newest');

                    // Clear URL parameters
                    window.history.replaceState({}, '', window.location.pathname);

                    filterPets();
                };

                // Initial filter application
                filterPets();
            });

