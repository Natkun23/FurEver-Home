    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

        // Toggle notification dropdown
    function toggleNotifications() {
        const dropdown = document.getElementById('notificationDropdown');
        dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
    }

    // Mark notification as read
    function markAsRead(notificationId) {
        fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ id: notificationId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Reload to update badge count
                location.reload();
            }
        });
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const bell = event.target.closest('.notification-bell');
        const dropdown = document.getElementById('notificationDropdown');

        if (!bell && dropdown) {
            dropdown.style.display = 'none';
        }
    });
        // Toggle filters visibility
        function toggleFilters() {
            const content = document.getElementById('filterContent');
            const icon = document.getElementById('filterToggleIcon');

            content.classList.toggle('show');
            icon.classList.toggle('active');
        }

        $(document).ready(function () {
            // Store original pet count
            const totalPets = @Model.Count;

            // Filter and Search functionality - FIXED
            function filterPets() {
                const searchTerm = $('#searchInput').val().toLowerCase().trim();
                const gender = $('#genderFilter').val();
                const size = $('#sizeFilter').val();
                const ageRange = $('#ageFilter').val();

                let visibleCount = 0;

                console.log('Filtering with:', { searchTerm, gender, size, ageRange });

                $('.pet-card').each(function () {
                    const $card = $(this);
                    const name = ($card.attr('data-name') || '').toLowerCase();
                    const petGender = ($card.attr('data-gender') || '').trim();
                    const petSize = ($card.attr('data-size') || '').trim();
                    const petAge = parseFloat($card.attr('data-age')) || 0;

                    console.log('Card data:', { name, petGender, petSize, petAge });

                    let show = true;

                    // Search filter
                    if (searchTerm && name.indexOf(searchTerm) === -1) {
                        show = false;
                        console.log('Failed search filter');
                    }

                    // Gender filter
                    if (gender && petGender !== gender) {
                        show = false;
                        console.log('Failed gender filter:', petGender, '!==', gender);
                    }

                    // Size filter
                    if (size && petSize !== size) {
                        show = false;
                        console.log('Failed size filter:', petSize, '!==', size);
                    }

                    // Age filter
                    if (ageRange) {
                        const [min, max] = ageRange.split('-').map(Number);
                        if (petAge < min || petAge > max) {
                            show = false;
                            console.log('Failed age filter:', petAge, 'not between', min, 'and', max);
                        }
                    }

                    if (show) {
                        $card.fadeIn(300);
                        visibleCount++;
                    } else {
                        $card.fadeOut(300);
                    }
                });

                $('#resultsCount').text(visibleCount);
                updateActiveFilters();
            }

            // Update active filter tags
            function updateActiveFilters() {
                const $container = $('#activeFilters');
                $container.empty();

                const searchTerm = $('#searchInput').val().trim();
                const gender = $('#genderFilter').val();
                const size = $('#sizeFilter').val();
                const ageRange = $('#ageFilter').val();

                // Only show filter tags if there are active filters
                if (!searchTerm && !gender && !size && !ageRange) {
                    return;
                }

                if (searchTerm) {
                    $container.append(`
                        <div class="filter-tag">
                            <span>Search: "${searchTerm}"</span>
                        </div>
                    `);
                }

                if (gender) {
                    $container.append(`
                        <div class="filter-tag">
                            <span>Gender: ${gender}</span>
                            <i class="fas fa-times" onclick="$('#genderFilter').val(''); filterPets();"></i>
                        </div>
                    `);
                }

                if (size) {
                    $container.append(`
                        <div class="filter-tag">
                            <span>Size: ${size}</span>
                            <i class="fas fa-times" onclick="$('#sizeFilter').val(''); filterPets();"></i>
                        </div>
                    `);
                }

                if (ageRange) {
                    const ageLabels = {
                        '0-1': 'Puppy/Kitten (0-1 year)',
                        '1-3': 'Young (1-3 years)',
                        '3-7': 'Adult (3-7 years)',
                        '7-100': 'Senior (7+ years)'
                    };
                    $container.append(`
                        <div class="filter-tag">
                            <span>Age: ${ageLabels[ageRange]}</span>
                            <i class="fas fa-times" onclick="$('#ageFilter').val(''); filterPets();"></i>
                        </div>
                    `);
                }
            }

            // Sort functionality - FIXED
            function sortPets() {
                const sortValue = $('#sortSelect').val();
                const $grid = $('#petsGrid');
                const $cards = $grid.children('.pet-card').get();

                $cards.sort(function (a, b) {
                    const $a = $(a);
                    const $b = $(b);

                    switch (sortValue) {
                        case 'newest':
                            return parseInt($b.attr('data-date')) - parseInt($a.attr('data-date'));
                        case 'oldest':
                            return parseInt($a.attr('data-date')) - parseInt($b.attr('data-date'));
                        case 'name-asc':
                            return ($a.attr('data-name') || '').localeCompare($b.attr('data-name') || '');
                        case 'name-desc':
                            return ($b.attr('data-name') || '').localeCompare($a.attr('data-name') || '');
                        case 'age-asc':
                            return (parseInt($a.attr('data-age')) || 0) - (parseInt($b.attr('data-age')) || 0);
                        case 'age-desc':
                            return (parseInt($b.attr('data-age')) || 0) - (parseInt($a.attr('data-age')) || 0);
                        default:
                            return 0;
                    }
                });

                $.each($cards, function (idx, card) {
                    $grid.append(card);
                });
            }

            // Reset filters
            window.resetFilters = function() {
                $('#searchInput').val('');
                $('#genderFilter').val('');
                $('#sizeFilter').val('');
                $('#ageFilter').val('');
                filterPets();
            };

            // Event listeners
            $('#searchInput').on('keyup', function() {
                filterPets();
            });

            $('#genderFilter, #sizeFilter, #ageFilter').on('change', function() {
                filterPets();
            });

            $('#sortSelect').on('change', function() {
                sortPets();
            });

            // Initialize
            filterPets();
        });

        // Prevent back button after logout
        window.history.forward();
        function noBack() {
            window.history.forward();
        }
    </script>
</body>
</html>