        // ===== BULLETPROOF BACK BUTTON PREVENTION =====
        // This works for Dashboard.cshtml, Index.cshtml, and VerifyOtp.cshtml

        <script>
(function() {
    'use strict';

    let navigationLocked = false;
    let lockTimeout = null;

    // Immediately lock navigation on page load
    function lockNavigation() {
        navigationLocked = true;

        // Push multiple states to make it harder to bypass
        for (let i = 0; i < 3; i++) {
            window.history.pushState(
                { locked: true, timestamp: Date.now() },
                '',
                window.location.href
            );
        }
    }

    // Handle popstate (back button)
    function handlePopState(event) {
        if (navigationLocked) {
            // Immediately push forward - no delay
            window.history.pushState(
                { locked: true, timestamp: Date.now() },
                '',
                window.location.href
            );

            // Clear any existing timeout
            if (lockTimeout) {
                clearTimeout(lockTimeout);
            }

            // Re-lock after a brief moment to catch rapid clicks
            lockTimeout = setTimeout(function() {
                lockNavigation();
            }, 10);

            // Prevent any default action
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            return false;
        }
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', lockNavigation);
    } else {
        lockNavigation();
    }

    // Listen for popstate
    window.addEventListener('popstate', handlePopState, true);

    // Also listen for hashchange (in case someone tries that)
    window.addEventListener('hashchange', function(e) {
        if (navigationLocked) {
            e.preventDefault();
            window.history.pushState(
                { locked: true, timestamp: Date.now() },
                '',
                window.location.href
            );
            return false;
        }
    }, true);

    // Prevent keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        // Alt + Left (back)
        if (e.altKey && (e.keyCode === 37 || e.key === 'ArrowLeft')) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            return false;
        }

        // Backspace (except in inputs)
        if (e.keyCode === 8 || e.key === 'Backspace') {
            const element = e.target;
            const isEditable = element.tagName === 'INPUT' ||
                             element.tagName === 'TEXTAREA' ||
                             element.isContentEditable;

            if (!isEditable) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                return false;
            }
        }
    }, true);

    // Prevent mouse back button (button 3/4 on some mice)
    document.addEventListener('mousedown', function(e) {
        if (e.button === 3 || e.button === 4) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            return false;
        }
    }, true);

    // Handle page visibility changes
    document.addEventListener('visibilitychange', function() {
        if (!document.hidden && navigationLocked) {
            // Re-lock when page becomes visible
            lockNavigation();
        }
    });

    // Handle page show/hide events
    window.addEventListener('pageshow', function(event) {
        if (event.persisted && navigationLocked) {
            // Page loaded from cache - re-lock
            lockNavigation();
        }
    });

    // Prevent beforeunload circumvention
    let unloadAllowed = false;

    window.addEventListener('beforeunload', function(e) {
        if (navigationLocked && !unloadAllowed) {
            // This will be caught by our popstate handler
            lockNavigation();
        }
    });

    // Allow navigation for specific actions
    function allowNavigation() {
        navigationLocked = false;
        unloadAllowed = true;
    }

    // Allow logout links
    document.addEventListener('click', function(e) {
        const target = e.target.closest('a, button');
        if (target) {
            const href = target.getAttribute('href') || '';
            const onclick = target.getAttribute('onclick') || '';

            // Check if it's a logout link or form submit
            if (href.includes('Logout') ||
                onclick.includes('Logout') ||
                target.type === 'submit') {
                allowNavigation();
            }
        }
    }, true);

    // Override history methods to prevent bypassing
    const originalPushState = history.pushState;
    const originalReplaceState = history.replaceState;

    history.pushState = function(state, title, url) {
        if (navigationLocked && (!state || !state.locked)) {
            return; // Block unauthorized pushState
        }
        return originalPushState.apply(history, arguments);
    };

    history.replaceState = function(state, title, url) {
        if (navigationLocked && (!state || !state.locked)) {
            return; // Block unauthorized replaceState
        }
        return originalReplaceState.apply(history, arguments);
    };

    // Session check (for logged-in pages only)
    @if (Session["UserId"] != null) {
        <text>
        setInterval(function() {
            fetch('@Url.Action("CheckSession", "Account")', {
                method: 'GET',
                cache: 'no-cache'
            })
            .then(function(response) {
                if (!response.ok) {
                    allowNavigation();
                    window.location.replace('@Url.Action("Login", "Account")');
                }
            })
            .catch(function() {
                // Silent fail - will retry on next interval
            });
        }, 30000); // Check every 30 seconds
        </text>
    }

    // For VerifyOtp page - check if already logged in
    @if (ViewBag.Title != null && ViewBag.Title.ToString().Contains("Dashboard")) {
        <text>
        // Update date/time for Dashboard
        function updateDateTime() {
            const now = new Date();
            const options = {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            };
            const dateTimeString = now.toLocaleDateString('en-US', options);
            const dateTimeElement = document.getElementById('currentDateTime');
            if (dateTimeElement) {
                dateTimeElement.textContent = dateTimeString;
            }
        }

        updateDateTime();
        setInterval(updateDateTime, 60000);
        </text>
    }

    console.log('🔒 Navigation locked - Back button disabled');

})();
        </script>


        <script>
        // ========== SIDEBAR FUNCTIONALITY ==========
        const sidebarToggle = document.getElementById('sidebarToggle'); // Keep for backward compatibility
        const navbarMenuToggle = document.getElementById('navbarMenuToggle'); // NEW
        const sidebarClose = document.getElementById('sidebarClose');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const customerSidebar = document.getElementById('customerSidebar');

        function openSidebar() {
            if (customerSidebar) {
                customerSidebar.classList.add('active');
                sidebarOverlay.classList.add('active');

                // Update navbar toggle button state
                if (navbarMenuToggle) {
                    navbarMenuToggle.classList.add('active');
                }

                // Keep old toggle button compatibility (if exists)
                if (sidebarToggle) {
                    sidebarToggle.classList.add('active');
                }

                document.body.style.overflow = 'hidden';
            }
        }

        function closeSidebar() {
            if (customerSidebar) {
                customerSidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');

                // Update navbar toggle button state
                if (navbarMenuToggle) {
                    navbarMenuToggle.classList.remove('active');
                }

                // Keep old toggle button compatibility (if exists)
                if (sidebarToggle) {
                    sidebarToggle.classList.remove('active');
                }

                document.body.style.overflow = '';
            }
        }

        // Click handler for old floating button (if exists)
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', openSidebar);
        }

        if (sidebarClose) {
            sidebarClose.addEventListener('click', closeSidebar);
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', closeSidebar);
        }

        // Close sidebar on ESC key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeSidebar();
            }
        });

        // ========== NOTIFICATION FUNCTIONALITY ==========
        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) {
                dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
            }
        }

        function markAsRead(notificationId) {
            fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: notificationId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function closeAutoPopup() {
            const popup = document.getElementById('autoNotificationPopup');
            if (popup) {
                popup.style.display = 'none';
            }
        }

        function markAsReadAndClose(notificationId) {
            fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: notificationId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closeAutoPopup();
                    location.reload();
                }
            });
        }

        // Auto-close notification popup after 10 seconds
        setTimeout(function () {
            const popup = document.getElementById('autoNotificationPopup');
            if (popup && popup.style.display !== 'none') {
                popup.style.animation = 'fadeOut 0.3s';
                setTimeout(function () {
                    popup.style.display = 'none';
                }, 300);
            }
        }, 10000);

        // Close notification dropdown when clicking outside
        document.addEventListener('click', function(event) {
            const bell = event.target.closest('.notification-bell');
            const dropdown = document.getElementById('notificationDropdown');

            if (!bell && dropdown) {
                dropdown.style.display = 'none';
            }
        });

        // ========== FILTER FUNCTIONALITY ==========
        $(window).on('scroll', function () {
            const filterSection = $('.filter-section');

            if ($(window).scrollTop() > 100) {
                filterSection.addClass('scrolled');
            } else {
                filterSection.removeClass('scrolled');
            }
        });

        function toggleFilters() {
            const content = document.getElementById('filterContent');
            const icon = document.getElementById('filterToggleIcon');

            if (content && icon) {
                content.classList.toggle('show');
                icon.classList.toggle('active');
            }
        }

        $(document).ready(function () {
            const totalPets = @Model.Count;

            function filterPets() {
                const searchTerm = $('#searchInput').val().toLowerCase().trim();
                const gender = $('#genderFilter').val();
                const size = $('#sizeFilter').val();
                const ageRange = $('#ageFilter').val();
                const location = $('#locationFilter').val().toLowerCase().trim();  // NEW

                let visibleCount = 0;

                $('.pet-card').each(function () {
                    const $card = $(this);
                    const name = ($card.attr('data-name') || '').toLowerCase();
                    const petGender = ($card.attr('data-gender') || '').trim();
                    const petSize = ($card.attr('data-size') || '').trim();
                    const petAge = parseFloat($card.attr('data-age')) || 0;
                    const petLocation = ($card.attr('data-location') || '').toLowerCase();  // NEW

                    let show = true;

                    if (searchTerm && name.indexOf(searchTerm) === -1) {
                        show = false;
                    }

                    if (gender && petGender !== gender) {
                        show = false;
                    }

                    if (size && petSize !== size) {
                        show = false;
                    }

                    if (ageRange) {
                        const [min, max] = ageRange.split('-').map(Number);
                        if (petAge < min || petAge > max) {
                            show = false;
                        }
                    }

                    // NEW: Location filter
                    if (location && petLocation.indexOf(location) === -1) {
                        show = false;
                    }

                    if (show) {
                        $card.fadeIn(300);
                        visibleCount++;
                    } else {
                        $card.fadeOut(300);
                    }
                });

                $('#resultsCount').text(visibleCount);
                updateActiveFilters();
            }

            function updateActiveFilters() {
                const $container = $('#activeFilters');
                $container.empty();

                const searchTerm = $('#searchInput').val().trim();
                const gender = $('#genderFilter').val();
                const size = $('#sizeFilter').val();
                const ageRange = $('#ageFilter').val();
                const location = $('#locationFilter').val().trim();  // ⭐ ADD THIS LINE

                if (!searchTerm && !gender && !size && !ageRange) {
                    return;
                }

                // Use data attributes instead of inline onclick
                if (searchTerm) {
                    $container.append(`
            <div class="filter-tag">
                <span>Search: "${searchTerm}"</span>
                <i class="fas fa-times" data-filter="search"></i>
            </div>
        `);
                }

                if (gender) {
                    $container.append(`
            <div class="filter-tag">
                <span>Gender: ${gender}</span>
                <i class="fas fa-times" data-filter="gender"></i>
            </div>
        `);
                }

                if (size) {
                    $container.append(`
            <div class="filter-tag">
                <span>Size: ${size}</span>
                <i class="fas fa-times" data-filter="size"></i>
            </div>
        `);
                }

                if (ageRange) {
                    const ageLabels = {
                        '0-1': 'Puppy/Kitten (0-1 year)',
                        '1-3': 'Young (1-3 years)',
                        '3-7': 'Adult (3-7 years)',
                        '7-100': 'Senior (7+ years)'
                    };
                    $container.append(`
            <div class="filter-tag">
                <span>Age: ${ageLabels[ageRange]}</span>
                <i class="fas fa-times" data-filter="age"></i>
            </div>
        `);
                }
                // ⭐ ADD THIS ENTIRE BLOCK HERE:
                if (location) {
                    $container.append(`
            <div class="filter-tag">
                <span>Location: "${location}"</span>
                <i class="fas fa-times" data-filter="location"></i>
            </div>
        `);
                }
            }

            // Add event delegation for filter tag close buttons
            $(document).on('click', '.filter-tag i[data-filter]', function () {
                const filterType = $(this).attr('data-filter');

                switch (filterType) {
                    case 'search':
                        $('#searchInput').val('');
                        break;
                    case 'gender':
                        $('#genderFilter').val('');
                        break;
                    case 'size':
                        $('#sizeFilter').val('');
                        break;
                    case 'age':
                        $('#ageFilter').val('');
                        break;
                    case 'location':  // ⭐ ADD THIS CASE
                        $('#locationFilter').val('');
                        break;
                }

                filterPets();
            });

            function sortPets() {
                const sortValue = $('#sortSelect').val();
                const $grid = $('#petsGrid');
                const $cards = $grid.children('.pet-card').get();

                $cards.sort(function (a, b) {
                    const $a = $(a);
                    const $b = $(b);

                    switch (sortValue) {
                        case 'newest':
                            return parseInt($b.attr('data-date')) - parseInt($a.attr('data-date'));
                        case 'oldest':
                            return parseInt($a.attr('data-date')) - parseInt($b.attr('data-date'));
                        case 'name-asc':
                            return ($a.attr('data-name') || '').localeCompare($b.attr('data-name') || '');
                        case 'name-desc':
                            return ($b.attr('data-name') || '').localeCompare($a.attr('data-name') || '');
                        case 'age-asc':
                            return (parseFloat($a.attr('data-age')) || 0) - (parseFloat($b.attr('data-age')) || 0);
                        case 'age-desc':
                            return (parseFloat($b.attr('data-age')) || 0) - (parseFloat($a.attr('data-age')) || 0);
                        default:
                            return 0;
                    }
                });

                $.each($cards, function (idx, card) {
                    $grid.append(card);
                });
            }

            window.resetFilters = function() {
                $('#searchInput').val('');
                $('#genderFilter').val('');
                $('#sizeFilter').val('');
                $('#ageFilter').val('');

                filterPets();
            };

            $('#searchInput').on('keyup', function() {
                filterPets();
            });
            $('#locationFilter').on('keyup', function () {
                filterPets();
            });

            $('#genderFilter, #sizeFilter, #ageFilter').on('change', function() {
                filterPets();
            });

            $('#sortSelect').on('change', function() {
                sortPets();
            });

            filterPets();
        });

        // Prevent back button after logout
        window.history.forward();
        function noBack() {
            window.history.forward();
        }

        </script>


