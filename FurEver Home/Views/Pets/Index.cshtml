                    @foreach (var pet in Model)
                    {
                        var petAge = pet.AgeUnit == "Months" ? (pet.Age / 12.0) : pet.Age;
                        var daysInCenter = pet.DaysInCenter;
                        <div class="pet-card"
                             data-name="@(pet.Name ?? "").ToLower()"
                             data-gender="@(pet.Gender ?? "")"
                             data-size="@(pet.Size ?? "")"
                             data-age="@petAge.ToString("F2")"
                             data-days="@daysInCenter"
                             data-date="@pet.DateAdded.ToString("yyyyMMdd")"
                             data-location="@(pet.Location ?? "").ToLower()"
                             style="display: block;">

                            <img src="@(string.IsNullOrEmpty(pet.ImageUrl) ? "https://via.placeholder.com/320x280?text=" + pet.Name : pet.ImageUrl)"
                                 alt="@pet.Name"
                                 class="pet-image">

                            @if (pet.PostedByType == "Organization")
                            {
                                <div class="posted-by-card-badge">
                                    <i class="fas fa-building"></i>
                                    <span>@pet.OrganizationName</span>
                                </div>
                            }
                            else if (pet.Creator != null)
                            {
                                <div class="posted-by-card-badge">
                                    <i class="fas fa-user"></i>
                                    <span>@pet.Creator.FullName</span>
                                </div>
                            }

                            <div class="pet-badge">@pet.AgeDisplay</div>
                            <div class="pet-days-badge">
                                <i class="fas fa-calendar-alt"></i>
