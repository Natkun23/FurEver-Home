    <script>
// Check if user needs ID verification
function checkIDVerification() {
    @if (Session["UserId"] != null)
    {
        var userId = (int)Session["UserId"];
        var user = db.Users.Find(userId);
        if (user != null && (string.IsNullOrEmpty(user.IDImageUrl) || user.IDStatus == "Rejected"))
        {
            <text>
            // Show verification modal if ID is missing or rejected
            document.getElementById('verificationRequiredModal').classList.add('show');
            </text>
        }
    }
}

function closeVerificationModal() {
    document.getElementById('verificationRequiredModal').classList.remove('show');
}

// Close modal on background click
document.addEventListener('click', function(e) {
    var modal = document.getElementById('verificationRequiredModal');
    if (e.target === modal) {
        closeVerificationModal();
    }
});

// Close modal on ESC key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeVerificationModal();
    }
});

// Intercept "Post Pet" button clicks
document.addEventListener('DOMContentLoaded', function() {
    // Find all "Post Pet" links/buttons
    var postPetLinks = document.querySelectorAll('a[href*="PostForAdoption"], .btn-secondary, .quick-action-btn');

    postPetLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            @if (Session["UserId"] != null)
            {
                var userId = (int)Session["UserId"];
                var user = db.Users.Find(userId);
                if (user != null && (string.IsNullOrEmpty(user.IDImageUrl) || user.IDStatus != "Verified"))
                {
                    <text>
                    e.preventDefault();
                    document.getElementById('verificationRequiredModal').classList.add('show');
                    </text>
                }
            }
        });
    });
});
    </script>

    <script>
// Show modal on page load if user is logged in but not verified
window.addEventListener('DOMContentLoaded', function() {
    @if (Session["UserId"] != null)
    {
        var userId = (int)Session["UserId"];
        var user = db.Users.Find(userId);
        if (user != null && string.IsNullOrEmpty(user.IDImageUrl))
        {
