                        {
                            <div style="text-align: center; margin-top: 15px; color: #64748b; font-size: 0.9em;">
                                + @(ViewBag.UnreadNotifications.Count - 1) more notification@(ViewBag.UnreadNotifications.Count > 2 ? "s" : "")
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <style>
            @@keyframes fadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(50px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes fadeOut {
                from {
                    opacity: 1;
                }

                to {
                    opacity: 0;
                }
            }
        </style>

        <script>
        function closeAutoPopup() {
            document.getElementById('autoNotificationPopup').style.display = 'none';
        }

        function markAsReadAndClose(notificationId) {
            fetch('@Url.Action("MarkNotificationAsRead", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: notificationId })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        closeAutoPopup();
                        location.reload();
                    }
                });
        }

        // Auto-close after 10 seconds
        setTimeout(function () {
            const popup = document.getElementById('autoNotificationPopup');
            if (popup && popup.style.display !== 'none') {
                popup.style.animation = 'fadeOut 0.3s';
                setTimeout(function () {
                    popup.style.display = 'none';
                }, 300);
            }
        }, 10000);
        </script>
    }

