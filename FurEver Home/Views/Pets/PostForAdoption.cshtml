@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = "Post Pet for Adoption - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .post-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .page-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 2.5em;
            color: #2E8BC0;
        }

        .page-title {
            font-size: 2.5em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 1.1em;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 14px 16px;
                border: 2px solid #e2e8f0;
                border-radius: 12px;
                font-size: 15px;
                transition: all 0.3s;
                outline: none;
                background: #f8fafc;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: #FFD93D;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(255, 217, 61, 0.1);
                }

            .form-group textarea {
                min-height: 120px;
                resize: vertical;
            }

        .file-upload {
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            background: #f8fafc;
            cursor: pointer;
            transition: all 0.3s;
        }

            .file-upload:hover {
                border-color: #FFD93D;
                background: #fffbeb;
            }

            .file-upload input[type="file"] {
                display: none;
            }

        .file-upload-icon {
            font-size: 3em;
            color: #FFD93D;
            margin-bottom: 15px;
        }

        .checkbox-group {
            display: flex;
            gap: 25px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .checkbox-item:hover {
                border-color: #FFD93D;
                background: #fffbeb;
            }

            .checkbox-item input[type="checkbox"] {
                width: auto;
                cursor: pointer;
            }

        .info-box {
            background: #fffbeb;
            border-left: 4px solid #FFD93D;
            padding: 20px;
            border-radius: 10px;
            margin: 30px 0;
        }

            .info-box h4 {
                color: #92400e;
                margin-bottom: 10px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .info-box ul {
                margin-left: 20px;
                color: #334155;
                line-height: 1.8;
            }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
            }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="post-card">
            <div class="page-header">
                <div class="page-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <h1 class="page-title">Post Pet for Adoption</h1>
                <p class="page-subtitle">Help your pet find a loving forever home</p>
            </div>

            @using (Html.BeginForm("PostForAdoption", "Pets", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-grid">
                    <div class="form-group">
                        <label>Pet Name *</label>
                        @Html.TextBoxFor(m => m.Name, new { placeholder = "Enter pet's name", required = "required" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Pet Type *</label>
                        @Html.DropDownListFor(m => m.PetTypeId,
                        new SelectList(ViewBag.PetTypes, "PetTypeId", "TypeName"),
                        "-- Select Type --",
                        new { required = "required" })
                        @Html.ValidationMessageFor(m => m.PetTypeId, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Breed *</label>
                        @Html.TextBoxFor(m => m.Breed, new { placeholder = "Enter breed", required = "required" })
                        @Html.ValidationMessageFor(m => m.Breed, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Age *</label>
                        @Html.TextBoxFor(m => m.Age, new { type = "number", min = "0", max = "20", placeholder = "Enter age", required = "required" })
                        @Html.ValidationMessageFor(m => m.Age, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Age Unit *</label>
                        @Html.DropDownListFor(m => m.AgeUnit,
                            new SelectList(new[] { "Months", "Years" }),
                            new { required = "required" })
                    </div>

                    <div class="form-group">
                        <label>Gender *</label>
                        @Html.DropDownListFor(m => m.Gender,
                        new SelectList(new[] { "Male", "Female" }),
                        "-- Select Gender --",
                        new { required = "required" })
                        @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        <label>Size *</label>
                        @Html.DropDownListFor(m => m.Size,
                        new SelectList(new[] { "Small", "Medium", "Large" }),
                        "-- Select Size --",
                        new { required = "required" })
                        @Html.ValidationMessageFor(m => m.Size, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <div class="form-group full-width">
                    <label>Description *</label>
                    @Html.TextAreaFor(m => m.Description, new { placeholder = "Describe your pet's personality, habits, and story...", rows = "4", required = "required" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group full-width">
                    <label>Personality Traits (comma-separated)</label>
                    @Html.TextBoxFor(m => m.Traits, new { placeholder = "e.g., Friendly, Playful, Gentle" })
                    <small style="color: #64748b;">Separate traits with commas</small>
                </div>

                <div class="form-group full-width">
                    <label>Vaccination Info</label>
                    @Html.TextAreaFor(m => m.Vaccines, new { placeholder = "List all vaccines your pet has received...", rows = "3" })
                </div>

                <div class="form-group full-width">
                    <label>Why should someone adopt this pet?</label>
                    @Html.TextAreaFor(m => m.WhyAdoptMe, new { placeholder = "e.g., Great with kids, Fully trained, Loves to play (comma-separated)", rows = "3" })
                    <small style="color: #64748b;">Separate reasons with commas</small>
                </div>

                <div class="form-group full-width">
                    <label>Health Status</label>
                    <div class="checkbox-group">
                        <div class="checkbox-item">
                            @Html.CheckBoxFor(m => m.IsHealthy, new { @checked = "checked" })
                            <label for="IsHealthy" style="margin: 0; font-weight: normal;">Healthy</label>
                        </div>
                        <div class="checkbox-item">
                            @Html.CheckBoxFor(m => m.IsNeutered, new { @checked = "checked" })
                            <label for="IsNeutered" style="margin: 0; font-weight: normal;">Spayed/Neutered</label>
                        </div>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label>Pet Photo *</label>
                    <div class="file-upload" onclick="document.getElementById('petImage').click()">
                        <div class="file-upload-icon"><i class="fas fa-camera"></i></div>
                        <div style="font-size: 1.1em; color: #334155; font-weight: 600; margin-bottom: 5px;">Upload Pet Photo</div>
                        <small style="color: #64748b;">Click to browse or drag and drop</small><br>
                        <small style="color: #64748b;">JPG, PNG (Max 5MB)</small>
                        <input type="file" id="petImage" name="PetImage" accept="image/*" required>
                        <div id="fileName" style="margin-top: 15px; color: #FFD93D; font-weight: 600;"></div>
                    </div>
                </div>

                <div class="info-box">
                    <h4><i class="fas fa-info-circle"></i> Important Information</h4>
                    <ul>
                        <li>All posted pets will be reviewed by our admin team</li>
                        <li>Provide accurate and honest information about your pet</li>
                        <li>You'll be notified once your pet listing is approved</li>
                        <li>We'll help match your pet with the perfect adopter</li>
                    </ul>
                </div>

                <div class="action-buttons">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-back">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-submit">
                        <i class="fas fa-heart"></i> Post for Adoption
                    </button>
                </div>
            }
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('petImage').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('fileName').textContent = '✓ ' + fileName;
            }
        });
    </script>
</body>
</html>



