@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = "Post Pet for Adoption - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .post-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .post-header {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            padding: 40px;
            color: #2E8BC0;
            text-align: center;
        }

        .post-header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 900;
        }

        .post-header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .post-body {
            padding: 40px;
        }

        .section-title {
            font-size: 1.5em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 15px;
            border-bottom: 3px solid #E8F4FC;
        }

        .info-banner {
            background: linear-gradient(135deg, #E8F4FC 0%, #d4e9f7 100%);
            border-left: 4px solid #3FA9F5;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            color: #1e40af;
        }

        .info-banner h4 {
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            color: #334155;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .required {
            color: #ef4444;
            margin-left: 3px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
            background: #f8fafc;
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #3FA9F5;
            background: white;
            box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        /* Custom Questions Section */
        .questions-section {
            background: #FFF9E6;
            padding: 30px;
            border-radius: 15px;
            border: 2px solid #FFD93D;
            margin: 30px 0;
        }

        .question-item {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 15px;
            border: 2px solid #e2e8f0;
            position: relative;
        }

        .question-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: #FFD93D;
            color: #2E8BC0;
            border-radius: 50%;
            font-weight: 700;
            margin-right: 10px;
        }

        .question-controls {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .question-controls select {
            flex: 1;
        }

        .btn-remove-question {
            background: #fee2e2;
            color: #dc2626;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-remove-question:hover {
            background: #fecaca;
        }

        .btn-add-question {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 14px 30px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 15px;
        }

        .btn-add-question:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        .btn-add-question:disabled {
            background: #cbd5e1;
            cursor: not-allowed;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 40px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
        }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-back:hover {
            background: #cbd5e1;
        }

        .file-upload-wrapper {
            position: relative;
            overflow: hidden;
        }

        .file-upload-label {
            display: inline-block;
            padding: 14px 30px;
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            color: white;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .file-upload-label:hover {
            transform: translateY(-2px);
        }

        .file-upload-wrapper input[type="file"] {
            position: absolute;
            left: -9999px;
        }

        .file-name {
            margin-top: 10px;
            color: #64748b;
            font-size: 14px;
        }

        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="post-card">
            <div class="post-header">
                <h1><i class="fas fa-heart"></i> Post Pet for Adoption</h1>
                <p>Help your furry friend find a loving home</p>
            </div>

            <div class="post-body">
                <div class="info-banner">
                    <h4><i class="fas fa-info-circle"></i> Important Information</h4>
                    <ul style="margin-left: 20px; line-height: 1.8;">
                        <li>Your post will be reviewed by our admin team before going live</li>
                        <li>You'll be able to review and approve adoption applications</li>
                        <li>You can create custom screening questions for potential adopters</li>
                        <li>Once an application is approved, you'll arrange pickup directly with the adopter</li>
                    </ul>
                </div>

                @using (Html.BeginForm("PostForAdoption", "Pets", FormMethod.Post, new { enctype = "multipart/form-data", id = "postForm" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- SECTION 1: PET INFORMATION -->
                    <div class="section-title">
                        <i class="fas fa-paw"></i>
                        Pet Information
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Pet Name <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { placeholder = "Enter pet's name", required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Pet Type <span class="required">*</span></label>
                            @Html.DropDownListFor(m => m.PetTypeId,
                                new SelectList(ViewBag.PetTypes, "PetTypeId", "TypeName"),
                                "-- Select Pet Type --",
                                new { required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Breed <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.Breed, new { placeholder = "e.g., Labrador, Persian", required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Age <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.Age, new { type = "number", min = "0", placeholder = "Enter age", required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Age Unit <span class="required">*</span></label>
                            @Html.DropDownListFor(m => m.AgeUnit,
                                new SelectList(new[] { "Months", "Years" }),
                                "-- Select Unit --",
                                new { required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Gender <span class="required">*</span></label>
                            @Html.DropDownListFor(m => m.Gender,
                                new SelectList(new[] { "Male", "Female" }),
                                "-- Select Gender --",
                                new { required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Size <span class="required">*</span></label>
                            @Html.DropDownListFor(m => m.Size,
                                new SelectList(new[] { "Small", "Medium", "Large" }),
                                "-- Select Size --",
                                new { required = "required" })
                        </div>

                        <div class="form-group">
                            <label>Days in Your Care <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.DaysInCenter, new { type = "number", min = "0", placeholder = "How long have you had this pet?", required = "required" })
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Description <span class="required">*</span></label>
                        @Html.TextAreaFor(m => m.Description, new { placeholder = "Describe your pet's personality, habits, and temperament...", rows = "4", required = "required" })
                    </div>

                    <div class="form-group full-width">
                        <label>Personality Traits (comma-separated)</label>
                        @Html.TextBoxFor(m => m.Traits, new { placeholder = "e.g., Friendly, Playful, Good with kids" })
                    </div>

                    <div class="form-group full-width">
                        <label>Vaccination Info</label>
                        @Html.TextAreaFor(m => m.Vaccines, new { placeholder = "List vaccines given (e.g., Rabies, Distemper, Parvo)", rows = "3" })
                    </div>

                    <div class="form-group full-width">
                        <label>Why Should Someone Adopt This Pet?</label>
                        @Html.TextAreaFor(m => m.WhyAdoptMe, new { placeholder = "Share what makes this pet special...", rows = "3" })
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label style="display: flex; align-items: center; gap: 8px;">
                                @Html.CheckBoxFor(m => m.IsHealthy, new { @checked = "checked" })
                                <span>Pet is Healthy</span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label style="display: flex; align-items: center; gap: 8px;">
                                @Html.CheckBoxFor(m => m.IsNeutered, new { @checked = "checked" })
                                <span>Pet is Neutered/Spayed</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Pet Photo <span class="required">*</span></label>
                        <div class="file-upload-wrapper">
                            <label for="petImage" class="file-upload-label">
                                <i class="fas fa-camera"></i> Choose Photo
                            </label>
                            <input type="file" id="petImage" name="PetImage" accept="image/*" required onchange="displayFileName(this)" />
                            <div class="file-name" id="fileName">No file chosen</div>
                        </div>
                    </div>

                    <!-- SECTION 2: CUSTOM SCREENING QUESTIONS -->
                    <div class="section-title" style="margin-top: 40px;">
                        <i class="fas fa-clipboard-question"></i>
                        Custom Screening Questions (Optional)
                    </div>

                    <div class="info-banner" style="background: #FFF9E6; border-left-color: #FFD93D;">
                        <h4 style="color: #92400e;"><i class="fas fa-lightbulb"></i> Create Your Own Questions</h4>
                        <p style="color: #92400e;">Add up to 5 custom questions to help you find the best match for your pet. These will be shown to potential adopters when they apply.</p>
                    </div>

                    <div class="questions-section" id="questionsSection">
                        <div id="questionsContainer">
                            <!-- Questions will be added here dynamically -->
                        </div>

                        <button type="button" class="btn-add-question" id="btnAddQuestion" onclick="addQuestion()">
                            <i class="fas fa-plus-circle"></i> Add Question
                        </button>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="action-buttons">
                        <a href="@Url.Action("Index", "Pets")" class="btn btn-back">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-submit">
                            <i class="fas fa-paper-plane"></i> Submit for Review
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        let questionCount = 0;
        const maxQuestions = 5;

        function displayFileName(input) {
            const fileName = input.files[0]?.name || 'No file chosen';
            document.getElementById('fileName').textContent = fileName;
        }

        function addQuestion() {
            if (questionCount >= maxQuestions) {
                alert('Maximum 5 questions allowed');
                return;
            }

            questionCount++;
            const container = document.getElementById('questionsContainer');

            const questionDiv = document.createElement('div');
            questionDiv.className = 'question-item';
            questionDiv.id = `question-${questionCount}`;

            questionDiv.innerHTML = `
                    <div style="display: flex; align-items: center; margin-bottom: 10px;">
                        <span class="question-number">${questionCount}</span>
                        <strong style="color: #2E8BC0;">Question ${questionCount}</strong>
                    </div>

                    <input type="text"
                           name="Questions[${questionCount - 1}]"
                           placeholder="Enter your question (e.g., Do you have experience with this breed?)"
                           required
                           style="width: 100%; padding: 12px; border: 2px solid #e2e8f0; border-radius: 10px; margin-bottom: 10px;" />

                    <div class="question-controls">
                        <select name="QuestionTypes[${questionCount - 1}]"
                                style="padding: 12px; border: 2px solid #e2e8f0; border-radius: 10px;">
                            <option value="Text">Text Answer</option>
                            <option value="YesNo">Yes/No</option>
                        </select>

                        <button type="button" class="btn-remove-question" onclick="removeQuestion(${questionCount})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                `;

            container.appendChild(questionDiv);

            // Disable add button if max reached
            if (questionCount >= maxQuestions) {
                document.getElementById('btnAddQuestion').disabled = true;
                document.getElementById('btnAddQuestion').style.opacity = '0.5';
            }
        }

        function removeQuestion(id) {
            const element = document.getElementById(`question-${id}`);
            if (element) {
                element.remove();
                questionCount--;

                // Re-enable add button
                document.getElementById('btnAddQuestion').disabled = false;
                document.getElementById('btnAddQuestion').style.opacity = '1';

                // Renumber remaining questions
                renumberQuestions();
            }
        }

        function renumberQuestions() {
            const questions = document.querySelectorAll('.question-item');
            questions.forEach((q, index) => {
                const number = index + 1;
                q.querySelector('.question-number').textContent = number;
                q.querySelector('strong').textContent = `Question ${number}`;
            });
            questionCount = questions.length;
        }
    </script>
</body>
</html>