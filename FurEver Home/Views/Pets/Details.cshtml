@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = Model.Name + " - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #f8fafc;
            min-height: 100vh;
        }

        /* Navigation */
        .navbar {
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            padding: 16px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid #e2e8f0;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: opacity 0.2s;
        }

            .logo:hover {
                opacity: 0.8;
            }

        .back-link {
            color: #2E8BC0;
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: #f0f6fb;
            border-radius: 8px;
            transition: all 0.2s;
            font-size: 0.95em;
            border: 1px solid transparent;
        }

            .back-link:hover {
                background: #2E8BC0;
                color: white;
                border-color: #1e5f8f;
                transform: translateX(-2px);
            }

        /* Pet Details */
        .pet-details-container {
            max-width: 1600px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .pet-details-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 40px;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
        }

        .pet-image-section {
            position: relative;
            background: #f8fafc;
            overflow: hidden;
        }

        .pet-main-image {
            width: 100%;
            height: 700px;
            object-fit: cover;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: block;
        }

        .pet-image-section:hover .pet-main-image {
            transform: scale(1.08);
        }

        .pet-type-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #2E8BC0;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.8em;
            box-shadow: 0 4px 12px rgba(46, 139, 192, 0.2);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            backdrop-filter: blur(4px);
        }

        .pet-id-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            background: white;
            color: #2E8BC0;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85em;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .pet-info-section {
            padding: 50px 40px;
            max-height: 700px;
            overflow-y: auto;
        }

            .pet-info-section::-webkit-scrollbar {
                width: 8px;
            }

            .pet-info-section::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 10px;
            }

            .pet-info-section::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
                transition: background 0.2s;
            }

            .pet-info-section::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        .pet-name-header {
            margin-bottom: 28px;
            animation: slideDown 0.5s ease-out;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .pet-name {
            font-size: 3.2em;
            color: #1a202c;
            font-weight: 700;
            margin-bottom: 8px;
            line-height: 1.1;
            letter-spacing: -0.5px;
        }

        .pet-breed {
            font-size: 1.15em;
            color: #64748b;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .pet-breed::before {
                content: "";
                width: 3px;
                height: 20px;
                background: #2E8BC0;
                border-radius: 2px;
            }

        .pet-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* Changed from 3 to 4 */
            gap: 16px;
            margin: 32px 0;
        }

        .stat-box {
            text-align: center;
            padding: 22px 16px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

            .stat-box::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #2E8BC0, #3FA9F5);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.3s ease;
            }

            .stat-box:hover {
                transform: translateY(-4px);
                border-color: #2E8BC0;
                box-shadow: 0 8px 16px rgba(46, 139, 192, 0.12);
            }

            .stat-box:hover::before {
                transform: scaleX(1);
            }

        .stat-icon {
            font-size: 2.2em;
            margin-bottom: 12px;
            display: block;
            line-height: 1;
            color: #2E8BC0;
        }

        .stat-label {
            font-size: 0.8em;
            color: #64748b;
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 1.2em;
            color: #1a202c;
            font-weight: 700;
        }

        .section-title {
            font-size: 1.35em;
            color: #1a202c;
            font-weight: 600;
            margin: 32px 0 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-title::before {
                content: "";
                width: 3px;
                height: 26px;
                background: #2E8BC0;
                border-radius: 2px;
            }

        .pet-description {
            color: #475569;
            line-height: 1.8;
            font-size: 1em;
            margin-bottom: 32px;
            padding: 20px;
            background: #f8fafc;
            border-radius: 12px;
            border-left: 3px solid #2E8BC0;
            transition: all 0.3s;
        }

            .pet-description:hover {
                background: #f1f5f9;
                border-left-color: #3FA9F5;
            }

        .pet-traits {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 32px;
        }

        .trait {
            background: white;
            color: #2E8BC0;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.9em;
            border: 1.5px solid #cbd5e1;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: default;
        }

            .trait:hover {
                border-color: #2E8BC0;
                background: #f0f6fb;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(46, 139, 192, 0.1);
            }

        .vaccines-box {
            background: #f0fdf4;
            border-left: 3px solid #10b981;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 32px;
            box-shadow: 0 1px 3px rgba(16, 185, 129, 0.1);
            border: 1px solid #dcfce7;
            transition: all 0.3s;
        }

            .vaccines-box:hover {
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
                border-color: #bbf7d0;
            }

            .vaccines-box h4 {
                color: #065f46;
                margin-bottom: 12px;
                font-size: 1.05em;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .vaccines-box p {
                color: #1e4e43;
                line-height: 1.7;
                font-size: 0.95em;
            }

        .why-adopt-box {
            background: #fffbeb;
            border-left: 3px solid #d97706;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 32px;
            box-shadow: 0 1px 3px rgba(217, 119, 6, 0.1);
            border: 1px solid #fef08a;
            transition: all 0.3s;
        }

            .why-adopt-box:hover {
                box-shadow: 0 4px 12px rgba(217, 119, 6, 0.15);
                border-color: #fcd34d;
            }

            .why-adopt-box h4 {
                color: #7c2d12;
                margin-bottom: 16px;
                font-size: 1.1em;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .why-adopt-list {
            list-style: none;
            padding: 0;
        }

            .why-adopt-list li {
                color: #57463a;
                margin-bottom: 10px;
                padding-left: 28px;
                position: relative;
                line-height: 1.6;
                font-size: 0.95em;
                transition: all 0.2s;
            }

                .why-adopt-list li:hover {
                    padding-left: 32px;
                    color: #2d1810;
                }

                .why-adopt-list li:before {
                    content: "•";
                    position: absolute;
                    left: 0;
                    color: #d97706;
                    font-weight: bold;
                    font-size: 1.3em;
                    line-height: 1;
                }

        .adoption-box {
            background: white;
            border: 2px solid #2E8BC0;
            padding: 32px;
            border-radius: 12px;
            color: #1a202c;
            margin-top: 32px;
            transition: all 0.3s;
            box-shadow: 0 2px 8px rgba(46, 139, 192, 0.08);
        }

            .adoption-box:hover {
                border-color: #3FA9F5;
                box-shadow: 0 8px 20px rgba(46, 139, 192, 0.15);
            }

            .adoption-box h3 {
                font-size: 1.45em;
                margin-bottom: 16px;
                font-weight: 600;
                color: #1a202c;
            }

            .adoption-box p {
                margin-bottom: 20px;
                line-height: 1.7;
                font-size: 0.95em;
                color: #475569;
            }

        .btn-adopt-now {
            width: 100%;
            background: #2E8BC0;
            color: white;
            padding: 16px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1.05em;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 12px rgba(46, 139, 192, 0.2);
            margin-top: 8px;
        }

            .btn-adopt-now:hover {
                background: #1e5f8f;
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(46, 139, 192, 0.3);
            }

            .btn-adopt-now:active {
                transform: translateY(0);
            }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 20px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 18px;
            background: white;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }

            .info-item:hover {
                border-color: #2E8BC0;
                background: #f8fafc;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(46, 139, 192, 0.1);
            }

        .info-icon {
            font-size: 1.8em;
            color: #2E8BC0;
        }

        .info-label {
            font-size: 0.85em;
            color: #64748b;
            margin: 0;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .info-value {
            font-weight: 700;
            color: #1a202c;
            font-size: 1.2em;
        }

        .days-badge {
            background: white;
            border: 2px solid #2E8BC0;
            color: #2E8BC0;
            padding: 24px;
            border-radius: 12px;
            text-align: center;
            margin: 28px 0;
            box-shadow: 0 2px 8px rgba(46, 139, 192, 0.1);
            transition: all 0.3s;
        }

            .days-badge:hover {
                border-color: #3FA9F5;
                box-shadow: 0 8px 20px rgba(46, 139, 192, 0.15);
                transform: translateY(-2px);
            }

        .days-badge .label {
            font-size: 0.85em;
            margin-bottom: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
        }

        .days-badge .value {
            font-size: 2.5em;
            font-weight: 700;
            line-height: 1;
            color: #2E8BC0;
        }

        .alert-box {
            background: #e0f2fe;
            border: 1px solid #bae6fd;
            border-left: 3px solid #0c4a6e;
            padding: 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            color: #0c4a6e;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: all 0.2s;
        }

            .alert-box:hover {
                border-left-color: #2E8BC0;
                box-shadow: 0 2px 8px rgba(46, 139, 192, 0.1);
            }

            .alert-box i {
                font-size: 1.2em;
                margin-top: 2px;
                flex-shrink: 0;
                color: #2E8BC0;
            }

            .alert-box a {
                color: #2E8BC0;
                text-decoration: underline;
                font-weight: 600;
                transition: color 0.2s;
            }

                .alert-box a:hover {
                    color: #1e5f8f;
                }

        @@media (max-width: 1200px) {
            .pet-details-grid {
                grid-template-columns: 1fr;
            }

            .pet-main-image {
                height: 500px;
            }

            .pet-info-section {
                padding: 40px 30px;
                max-height: none;
            }

            .pet-name {
                font-size: 2.4em;
            }
        }

        @@media (max-width: 768px) {
            .pet-stats {
                grid-template-columns: 1fr;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .pet-name {
                font-size: 1.9em;
            }

            .pet-details-container {
                margin: 20px auto;
            }

            .pet-info-section {
                padding: 30px 20px;
            }

            .adoption-box {
                padding: 24px;
            }

            .pet-details-grid {
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="@Url.Action("Index", "Pets")" class="logo">
                <img src="~/Content/Images/full_furever.png" alt="FurEver Home" style="height: 55px;">
            </a>
            @if (Session["UserRole"] != null && Session["UserRole"].ToString() != "Client")
            {
                <a href="@Url.Action("Pets", "Admin")" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to Admin Pets
                </a>
            }
            else
            {
                <!-- ⭐ Modified: Use JavaScript to go back with history -->
                <a href="#" onclick="goBackToFilters(); return false;" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to All Pets
                </a>
            }
        </div>
    </nav>

    <script>
        function goBackToFilters() {
            // Check if user came from Index page
            if (document.referrer.includes('/Pets/Index') ||
                document.referrer.includes('/Pets/Dogs') ||
                document.referrer.includes('/Pets/Cats')) {
                // Go back to preserve filters
                window.history.back();
            } else {
                // Fresh navigation - go to index
                window.location.href = '@Url.Action("Index", "Pets")';
            }
        }
    </script>



    <!-- Pet Details -->
    <div class="pet-details-container">
        <div class="pet-details-grid">
            <div class="pet-image-section">
                <!-- Main Display Image -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="pet-main-image" id="mainImage">
                }
                else
                {
                    <img src="https://images.unsplash.com/photo-1633722715463-d30f4f325e24?w=600" alt="@Model.Name" class="pet-main-image" id="mainImage">
                }

                <!-- Thumbnail Gallery (only show if multiple images exist) -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl2) || !string.IsNullOrEmpty(Model.ImageUrl3))
                {
                    <div class="thumbnail-gallery">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="thumbnail active" onclick="changeMainImage(this)">
                        }
                        @if (!string.IsNullOrEmpty(Model.ImageUrl2))
                        {
                            <img src="@Model.ImageUrl2" class="thumbnail" onclick="changeMainImage(this)">
                        }
                        @if (!string.IsNullOrEmpty(Model.ImageUrl3))
                        {
                            <img src="@Model.ImageUrl3" class="thumbnail" onclick="changeMainImage(this)">
                        }
                    </div>
                }

                <div class="pet-id-badge">@Model.Type.ToUpper() @Model.PetId</div>
                <div class="pet-type-badge">@Model.Type</div>
            </div>



            <style>
                .thumbnail-gallery {
                    position: absolute;
                    bottom: 20px;
                    left: 50%;
                    transform: translateX(-50%);
                    display: flex;
                    gap: 10px;
                    background: rgba(0, 0, 0, 0.5);
                    padding: 10px;
                    border-radius: 10px;
                    backdrop-filter: blur(8px);
                }

                .thumbnail {
                    width: 80px;
                    height: 80px;
                    object-fit: cover;
                    border-radius: 8px;
                    cursor: pointer;
                    border: 3px solid transparent;
                    transition: all 0.3s;
                    opacity: 0.7;
                }

                    .thumbnail:hover {
                        opacity: 1;
                        transform: scale(1.05);
                    }

                    .thumbnail.active {
                        border-color: #FFD93D;
                        opacity: 1;
                    }
            </style>

            <div class="pet-info-section">
                <div class="pet-name-header">
                    <div class="pet-name">@Model.Name</div>
                    <div class="pet-breed">@Model.Breed</div>
                </div>

                <div class="pet-stats">
                    <div class="stat-box">
                        <div class="stat-icon"><i class="far fa-calendar"></i></div>
                        <div class="stat-label">Age</div>
                        <div class="stat-value">@Model.AgeDisplay old</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-icon"><i class="fas fa-@(Model.Gender == "Male" ? "mars" : "venus")"></i></div>
                        <div class="stat-label">Sex</div>
                        <div class="stat-value">@Model.Gender</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-icon"><i class="fas fa-arrows-alt-v"></i></div>
                        <div class="stat-label">Size</div>
                        <div class="stat-value">@Model.Size</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="stat-label">Location</div>
                        <div class="stat-value">@(string.IsNullOrEmpty(Model.Location) ? "Not specified" : Model.Location)</div>
                    </div>
                </div>

                <div class="days-badge">
                    <div class="label">Days in Center</div>
                    <div class="value">@Model.DaysInCenter</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Vaccines))
                {
                    <div class="vaccines-box">
                        <h4><i class="fas fa-syringe"></i> Vaccines</h4>
                        <p>@Model.Vaccines</p>
                    </div>
                }

                <h3 class="section-title">Description</h3>
                <p class="pet-description">@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.Traits))
                {
                    <h3 class="section-title">Personality Traits</h3>
                    <div class="pet-traits">
                        @foreach (var trait in Model.Traits.Split(','))
                        {
                            <span class="trait">@trait.Trim()</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.WhyAdoptMe))
                {
                    <div class="why-adopt-box">
                        <h4><i class="fas fa-heart"></i> Why Adopt Me?</h4>
                        <ul class="why-adopt-list">
                            @foreach (var reason in Model.WhyAdoptMe.Split(','))
                            {
                                <li>@reason.Trim()</li>
                            }
                        </ul>
                    </div>
                }


                <div class="adoption-box">
                    <h3>Ready to Adopt @Model.Name?</h3>

                    @{
                        var isAdmin = Session["UserRole"] != null && Session["UserRole"].ToString() != "Client";
                        var currentUserId = Session["UserId"] != null ? (int)Session["UserId"] : 0;
                        var isOwner = Model.OwnerUserId.HasValue && Model.OwnerUserId.Value == currentUserId;
                    }

                    @if (isOwner)
                    {
                        <div class="alert-box" style="background: rgba(255, 255, 255, 0.25); border: 2px solid rgba(255, 255, 255, 0.3);">
                            <i class="fas fa-user-check"></i> <strong>You are the owner of this pet.</strong>
                        </div>
                        <p style="margin: 15px 0;">You cannot apply to adopt your own pet. Manage your pet posts and view applications in your dashboard.</p>
                        <a href="@Url.Action("CustomerDashboard", "MyPets")" class="btn-adopt-now">
                            <i class="fas fa-tachometer-alt"></i> Go to My Dashboard
                        </a>
                    }
                    else if (isAdmin)
                    {
                        <div class="alert-box">
                            <i class="fas fa-user-shield"></i> You are viewing this as an admin.
                        </div>
                        <a href="@Url.Action("Pets", "Admin")" class="btn-adopt-now">
                            <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
                        </a>
                    }
                    else
                    {
                        if (ViewBag.PendingApplicationsCount > 0)
                        {
                            <div class="alert-box">
                                <i class="fas fa-info-circle"></i>
                                <strong>@ViewBag.PendingApplicationsCount</strong>
                                @(ViewBag.PendingApplicationsCount == 1 ? "person is" : "people are")
                                currently interested in adopting @Model.Name.
                            </div>
                        }

                        if (ViewBag.UserHasApplied == true)
                        {
                            <div class="alert-box" style="margin-bottom: 20px;">
                                <i class="fas fa-check-circle"></i>
                                <div>
                                    <strong>You have already applied to adopt @Model.Name.</strong>
                                    <a href="@Url.Action("MyApplications", "Pets")" style="display: block; margin-top: 4px;">
                                        Check your application status
                                    </a>
                                </div>
                            </div>
                            <a href="@Url.Action("Index", "Pets")" class="btn-adopt-now">
                                <i class="fas fa-arrow-left"></i> Browse More Pets
                            </a>
                        }
                        else
                        {
                            <p>@Model.Name is ready to find their forever home! Complete our simple adoption application and we'll be in touch shortly.</p>
                            <a href="@Url.Action("Apply", "Pets", new { id = Model.PetId })" class="btn-adopt-now">
                                <i class="fas fa-heart"></i> Apply to Adopt @Model.Name
                            </a>
                        }
                    }

                    <div class="info-grid">
                        <div class="info-item">
                            <div>
                                <div class="info-label">Health Status</div>
                                <div class="info-value">@(Model.IsHealthy ? "Healthy" : "Under Care")</div>
                            </div>
                        </div>
                        <div class="info-item">
                            <div>
                                <div class="info-label">@(Model.Gender == "Male" ? "Neutered" : "Spayed")</div>
                                <div class="info-value">@(Model.IsNeutered ? "Yes" : "No")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
    function changeMainImage(thumbnail) {
        // Update main image
        document.getElementById('mainImage').src = thumbnail.src;

        // Update active thumbnail
        document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
        thumbnail.classList.add('active');
    }
</script>
</html>
