@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = Model.Name + " - FurEver Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #fff7ed 100%);
            min-height: 100vh;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 20px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: transform 0.3s;
        }

        .logo:hover { transform: scale(1.05); }

        .back-link {
            color: #2E8BC0;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
            border-radius: 12px;
            transition: all 0.3s;
            font-size: 1em;
        }

        .back-link:hover {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            color: white;
            transform: translateX(-5px);
        }

        .pet-details-container {
            max-width: 1400px;
            margin: 50px auto;
            padding: 0 30px;
        }

        .pet-details-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 40px;
            background: white;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.12);
        }

        .pet-image-section {
            position: relative;
            background: linear-gradient(135deg, #E8F4FC 0%, #FFF9E6 100%);
        }

        .pet-main-image {
            width: 100%;
            height: 700px;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .pet-image-section:hover .pet-main-image { transform: scale(1.05); }

        .pet-type-badge {
            position: absolute;
            top: 30px;
            right: 30px;
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
            padding: 14px 30px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1.1em;
            box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .pet-id-badge {
            position: absolute;
            top: 30px;
            left: 30px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            color: #2E8BC0;
            padding: 14px 30px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1.1em;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* ✨ NEW: POSTED BY BADGE */
        .posted-by-badge {
            position: absolute;
            bottom: 30px;
            left: 30px;
            right: 30px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 20px 25px;
            border-radius: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .posted-by-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5em;
        }

        .posted-by-info {
            flex: 1;
        }

        .posted-by-label {
            font-size: 0.85em;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .posted-by-name {
            font-size: 1.2em;
            color: #2E8BC0;
            font-weight: 700;
        }

        .pet-info-section {
            padding: 60px 50px;
            max-height: 700px;
            overflow-y: auto;
        }

        .pet-info-section::-webkit-scrollbar { width: 10px; }
        .pet-info-section::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        .pet-info-section::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%); border-radius: 10px; }

        .pet-name-header {
            margin-bottom: 35px;
            animation: fadeInDown 0.6s;
        }

        @@keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pet-name {
            font-size: 3.5em;
            background: linear-gradient(135deg, #2E8BC0 0%, #3FA9F5 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .pet-breed {
            font-size: 1.4em;
            color: #64748b;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pet-breed::before {
            content: "";
            width: 40px;
            height: 3px;
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            border-radius: 10px;
        }

        .pet-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 35px 0;
        }

        .stat-box {
            text-align: center;
            padding: 25px 20px;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border-radius: 20px;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .stat-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(63, 169, 245, 0.2);
            border-color: #3FA9F5;
        }

        .stat-icon {
            font-size: 2.8em;
            margin-bottom: 12px;
            display: block;
        }

        .stat-label {
            font-size: 0.9em;
            color: #64748b;
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 1.3em;
            color: #2E8BC0;
            font-weight: 800;
        }

        .section-title {
            font-size: 1.6em;
            color: #2E8BC0;
            font-weight: 800;
            margin: 35px 0 18px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title::before {
            content: "";
            width: 4px;
            height: 30px;
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            border-radius: 10px;
        }

        .pet-description {
            color: #475569;
            line-height: 1.9;
            font-size: 1.1em;
            margin-bottom: 35px;
            padding: 25px;
            background: #f8fafc;
            border-radius: 15px;
            border-left: 4px solid #3FA9F5;
        }

        .pet-traits {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 35px;
        }

        .trait {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 700;
            font-size: 1em;
            box-shadow: 0 4px 15px rgba(255, 217, 61, 0.3);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .trait::before {
            content: "✨";
            font-size: 1.2em;
        }

        .trait:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(255, 217, 61, 0.4);
        }

        .vaccines-box {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            border-left: 5px solid #10b981;
            padding: 25px 30px;
            border-radius: 15px;
            margin-bottom: 35px;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.1);
        }

        .vaccines-box h4 {
            color: #065f46;
            margin-bottom: 12px;
            font-size: 1.3em;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .vaccines-box p {
            color: #064e3b;
            line-height: 1.8;
            font-size: 1.05em;
        }

        .why-adopt-box {
            background: linear-gradient(135deg, #FFF9E6 0%, #FEF3C7 100%);
            border-left: 5px solid #FFD93D;
            padding: 25px 30px;
            border-radius: 15px;
            margin-bottom: 35px;
            box-shadow: 0 4px 15px rgba(255, 217, 61, 0.15);
        }

        .why-adopt-box h4 {
            color: #92400e;
            margin-bottom: 18px;
            font-size: 1.4em;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .why-adopt-list {
            list-style: none;
            padding: 0;
        }

        .why-adopt-list li {
            color: #78350f;
            margin-bottom: 12px;
            padding-left: 35px;
            position: relative;
            line-height: 1.7;
            font-size: 1.05em;
        }

        .why-adopt-list li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #FFD93D;
            font-weight: bold;
            font-size: 1.5em;
            background: rgba(255, 217, 61, 0.2);
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .adoption-box {
            background: linear-gradient(135deg, #2E8BC0 0%, #3FA9F5 100%);
            padding: 40px 35px;
            border-radius: 20px;
            color: white;
            margin-top: 35px;
            box-shadow: 0 10px 40px rgba(46, 139, 192, 0.3);
        }

        .adoption-box h3 {
            font-size: 1.8em;
            margin-bottom: 18px;
            font-weight: 800;
        }

        .adoption-box p {
            margin-bottom: 25px;
            line-height: 1.7;
            font-size: 1.05em;
        }

        .btn-adopt-now {
            width: 100%;
            background: white;
            color: #2E8BC0;
            padding: 20px;
            border: none;
            border-radius: 15px;
            font-weight: 800;
            font-size: 1.3em;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .btn-adopt-now:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.25);
            color: #2E8BC0;
            background: #FFD93D;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-top: 25px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            transition: all 0.3s;
        }

        .info-item:hover { background: rgba(255, 255, 255, 0.3); }

        .info-icon { font-size: 2em; }

        .info-label {
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 4px;
            font-weight: 600;
        }

        .info-value {
            font-weight: 800;
            color: white;
            font-size: 1.05em;
        }

        .days-badge {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
            padding: 25px 35px;
            border-radius: 20px;
            text-align: center;
            margin: 25px 0;
            box-shadow: 0 8px 25px rgba(255, 217, 61, 0.35);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        .days-badge .label {
            font-size: 1em;
            margin-bottom: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .days-badge .value {
            font-size: 3em;
            font-weight: 900;
            line-height: 1;
        }

        .alert-box {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .alert-box i { margin-right: 8px; }

        @@media (max-width: 1200px) {
            .pet-details-grid { grid-template-columns: 1fr; }
            .pet-main-image { height: 500px; }
            .pet-info-section { padding: 40px 30px; max-height: none; }
            .pet-name { font-size: 2.8em; }
        }

        @@media (max-width: 768px) {
            .pet-stats { grid-template-columns: 1fr; }
            .info-grid { grid-template-columns: 1fr; }
            .pet-name { font-size: 2.2em; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <img src="~/Content/Images/full_furever.png" alt="FurEver Home" style="height: 55px;">
            </a>
            @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
            {
                <a href="@Url.Action("Pets", "Admin")" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to Admin Pets
                </a>
            }
            else
            {
                <a href="@Url.Action("Index", "Pets")" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to All Pets
                </a>
            }
        </div>
    </nav>

    <div class="pet-details-container">
        <div class="pet-details-grid">
            <div class="pet-image-section">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="pet-main-image">
                }
                else
                {
                    <img src="https://images.unsplash.com/photo-1633722715463-d30f4f325e24?w=600" alt="@Model.Name" class="pet-main-image">
                }

                <div class="pet-id-badge">@Model.Type.ToUpper() @Model.PetId</div>
                <div class="pet-type-badge">@Model.Type</div>

                <!-- ✨ NEW: POSTED BY INFORMATION -->
                <div class="posted-by-badge">
                    @if (Model.PostedByType == "Organization")
                    {
                        <div class="posted-by-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="posted-by-info">
                            <div class="posted-by-label">Posted by Organization</div>
                            <div class="posted-by-name">@Model.OrganizationName</div>
                        </div>
                    }
                    else if (Model.Creator != null)
                    {
                        <div class="posted-by-icon">
                            @Model.Creator.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="posted-by-info">
                            <div class="posted-by-label">Posted by</div>
                            <div class="posted-by-name">@Model.Creator.FullName</div>
                        </div>
                    }
                    else
                    {
                        <div class="posted-by-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="posted-by-info">
                            <div class="posted-by-label">Posted by</div>
                            <div class="posted-by-name">FurEver Home</div>
                        </div>
                    }
                </div>
            </div>

            <div class="pet-info-section">
                <div class="pet-name-header">
                    <div class="pet-name">@Model.Name</div>
                    <div class="pet-breed">@Model.Breed</div>
                </div>

                <div class="pet-stats">
                    <div class="stat-box">
                        <div class="stat-icon">🎂</div>
                        <div class="stat-label">Age</div>
                        <div class="stat-value">@Model.AgeDisplay old</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-icon">@(Model.Gender == "Male" ? "♂️" : "♀️")</div>
                        <div class="stat-label">Sex</div>
                        <div class="stat-value">@Model.Gender</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-icon">📏</div>
                        <div class="stat-label">Size</div>
                        <div class="stat-value">@Model.Size</div>
                    </div>
                </div>

                @if (Model.DaysInCenter > 0)
                {
                    <div class="days-badge">
                        <div class="label">Days in Center</div>
                        <div class="value">@Model.DaysInCenter</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Vaccines))
                {
                    <div class="vaccines-box">
                        <h4>💉 Vaccines</h4>
                        <p>@Model.Vaccines</p>
                    </div>
                }

                <h3 class="section-title">Description</h3>
                <p class="pet-description">@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.Traits))
                {
                    <h3 class="section-title">Personality Traits</h3>
                    <div class="pet-traits">
                        @foreach (var trait in Model.Traits.Split(','))
                        {
                            <span class="trait">@trait.Trim()</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.WhyAdoptMe))
                {
                    <div class="why-adopt-box">
                        <h4>💝 Why Adopt Me?</h4>
                        <ul class="why-adopt-list">
                            @foreach (var reason in Model.WhyAdoptMe.Split(','))
                            {
                                <li>@reason.Trim()</li>
                            }
                        </ul>
                    </div>
                }

                <div class="adoption-box">
                    <h3>Ready to Adopt @Model.Name?</h3>

                    @{
                        var isAdmin = Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin";
                    }

                    @if (isAdmin)
                    {
                        <div class="alert-box">
                            <i class="fas fa-user-shield"></i> You are viewing this as an admin.
                        </div>
                        <a href="@Url.Action("Pets", "Admin")" class="btn-adopt-now">
                            <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
                        </a>
                    }
                    else
                    {
                        if (ViewBag.PendingApplicationsCount > 0)
                        {
                            <div class="alert-box">
                                <i class="fas fa-info-circle"></i>
                                <strong>@ViewBag.PendingApplicationsCount</strong>
                                @(ViewBag.PendingApplicationsCount == 1 ? "person is" : "people are")
                                currently interested in adopting @Model.Name.
                            </div>
                        }

                        if (ViewBag.UserHasApplied == true)
                        {
                            <div class="alert-box" style="margin-bottom: 20px;">
                                ✅ You have already applied to adopt @Model.Name.
                                <a href="@Url.Action("MyApplications", "Pets")" style="color: white; text-decoration: underline; font-weight: 700;">
                                    Check your application status
                                </a>
                            </div>
                            <a href="@Url.Action("Index", "Pets")" class="btn-adopt-now">
                                🐾 Browse More Pets
                            </a>
                        }
                        else
                        {
                            <p>@Model.Name is ready to find their forever home! Complete our simple adoption application and we'll be in touch shortly.</p>
                            <a href="@Url.Action("Apply", "Pets", new { id = Model.PetId })" class="btn-adopt-now">
                                🏠 Apply to Adopt @Model.Name
                            </a>
                        }
                    }

                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-icon">@(Model.IsHealthy ? "✅" : "⚠️")</span>
                            <div>
                                <div class="info-label">Health Status</div>
                                <div class="info-value">@(Model.IsHealthy ? "Healthy" : "Under Care")</div>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-icon">@(Model.IsNeutered ? "✅" : "⚠️")</span>
                            <div>
                                <div class="info-label">@(Model.Gender == "Male" ? "Neutered" : "Spayed")</div>
                                <div class="info-value">@(Model.IsNeutered ? "Yes" : "No")</div>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-icon">🔍</span>
                            <div>
                                <div class="info-label">Microchipped</div>
                                <div class="info-value">Yes</div>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-icon">💊</span>
                            <div>
                                <div class="info-label">Health Guarantee</div>
                                <div class="info-value">30 Days</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>