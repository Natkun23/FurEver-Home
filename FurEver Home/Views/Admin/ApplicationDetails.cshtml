@model FurEver_Home.Models.AdoptionApplication
@{
    ViewBag.Title = "Application Details - FurEver Home Admin";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            padding: 30px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .details-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #3FA9F5 0%, #2E8BC0 100%);
            padding: 40px;
            color: white;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .pet-image {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            object-fit: cover;
            border: 5px solid white;
        }

        .header-text h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .header-text p {
            opacity: 0.9;
        }

        .content {
            padding: 40px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-bottom: 30px;
        }

        .info-item label {
            display: block;
            color: #64748b;
            font-size: 0.85em;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .info-item .value {
            font-size: 1.1em;
            color: #334155;
            font-weight: 600;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: 600;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-approved {
            background: #d1fae5;
            color: #065f46;
        }

        .status-rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-completed {
            background: #dbeafe;
            color: #1e40af;
        }

        .section-title {
            font-size: 1.5em;
            color: #2E8BC0;
            margin: 30px 0 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .message-box {
            background: #f8fafc;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #3FA9F5;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .screening-section {
            background: linear-gradient(135deg, #FFF9E6 0%, #FFF4D4 100%);
            padding: 30px;
            border-radius: 15px;
            margin: 30px 0;
            border: 2px solid #FFD93D;
        }

        .screening-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #FFD93D;
        }

            .screening-header i {
                font-size: 2em;
                color: #F6C90E;
            }

            .screening-header h3 {
                color: #92400e;
                font-size: 1.4em;
            }

        .screening-question {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            border-left: 4px solid #3FA9F5;
        }

            .screening-question:last-child {
                margin-bottom: 0;
            }

        .question-label {
            font-weight: 700;
            color: #2E8BC0;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.05em;
        }

        .question-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            background: #3FA9F5;
            color: white;
            border-radius: 50%;
            font-weight: 700;
            font-size: 0.9em;
        }

        .answer-text {
            color: #334155;
            line-height: 1.7;
            padding: 12px;
            background: #f8fafc;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .answer-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.9em;
        }

        .answer-yes {
            background: #d1fae5;
            color: #065f46;
        }

        .answer-no {
            background: #fee2e2;
            color: #991b1b;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1em;
        }

        .btn-approve {
            background: #10b981;
            color: white;
        }

        .btn-reject {
            background: #ef4444;
            color: white;
        }

        .btn-back {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-pickup {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

        .btn-turnover {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .pickup-box {
            background: linear-gradient(135deg, #FFF9E6 0%, #FFD93D 30%);
            padding: 30px;
            border-radius: 15px;
            margin: 20px 0;
        }

            .pickup-box h3 {
                color: #92400e;
                margin-bottom: 20px;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
            }

            .form-group input, .form-group textarea {
                width: 100%;
                padding: 12px;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 15px;
            }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 4px solid #10b981;
        }

        .rejection-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 20px;
            max-width: 500px;
            width: 90%;
        }

            .modal-content h3 {
                color: #2E8BC0;
                margin-bottom: 20px;
            }

            .modal-content textarea {
                width: 100%;
                padding: 15px;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                min-height: 120px;
                font-size: 15px;
            }

        .modal-buttons {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .id-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: #d1fae5;
            color: #065f46;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9em;
        }
    </style>
</head>
<body>


    <div class="container">
        <div class="details-card">
            <div class="header">
                <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/120?text=Pet" : Model.Pet.ImageUrl)"
                     alt="@Model.Pet.Name" class="pet-image">
                <div class="header-text">
                    <h1>@Model.User.FullName wants to adopt @Model.Pet.Name</h1>
                    <p><i class="fas fa-calendar"></i> Applied on @Model.ApplicationDate.ToString("MMMM dd, yyyy")</p>
                    <p style="margin-top: 8px;">
                        <span class="id-badge">
                            <i class="fas fa-check-circle"></i> ID Verified
                        </span>
                    </p>
                </div>
            </div>

            <div class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert-success">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                    </div>
                }

                <div class="info-grid">
                    <div class="info-item">
                        <label>Applicant Name</label>
                        <div class="value">@Model.User.FullName</div>
                    </div>
                    <div class="info-item">
                        <label>Email</label>
                        <div class="value">@Model.User.Email</div>
                    </div>
                    <div class="info-item">
                        <label>Phone Number</label>
                        <div class="value">@Model.PhoneNumber</div>
                    </div>
                    <div class="info-item">
                        <label>Housing Type</label>
                        <div class="value">@Model.HousingType</div>
                    </div>
                    <div class="info-item">
                        <label>Has Other Pets</label>
                        <div class="value">@Model.HasPets</div>
                    </div>
                    <div class="info-item">
                        <label>Application Status</label>
                        <div class="value">
                            <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
                        </div>
                    </div>
                </div>

                <div class="section-title">Address</div>
                <div class="message-box">@Model.Address</div>

                <div class="section-title">Why They Want to Adopt</div>
                <div class="message-box">@Model.Message</div>

                @* ⭐ SCREENING ANSWERS SECTION *@
                @if (!string.IsNullOrEmpty(Model.ScreeningQ1Experience))
                {
                    <div class="screening-section">
                        <div class="screening-header">
                            <i class="fas fa-clipboard-check"></i>
                            <h3>Adoption Capability Screening Answers</h3>
                        </div>

                        <div class="screening-question">
                            <div class="question-label">
                                <span class="question-number">1</span>
                                Prior Pet Care Experience
                            </div>
                            <div class="answer-text">
                                @Model.ScreeningQ1Experience
                            </div>
                        </div>

                        <div class="screening-question">
                            <div class="question-label">
                                <span class="question-number">2</span>
                                Financial Commitment to Pet Expenses
                            </div>
                            <div style="margin-bottom: 10px;">
                                <span class="answer-badge @(Model.ScreeningQ2Financial == "Yes" ? "answer-yes" : "answer-no")">
                                    @(string.IsNullOrWhiteSpace(Model.ScreeningQ2Financial) ? "Not Answered" : Model.ScreeningQ2Financial)
                                </span>
                            </div>
                            <div class="answer-text">
                                @(string.IsNullOrWhiteSpace(Model.ScreeningQ2Explanation) ? "No explanation provided" : Model.ScreeningQ2Explanation)
                            </div>
                        </div>

                        <div class="screening-question">
                            <div class="question-label">
                                <span class="question-number">3</span>
                                Household Agreement
                            </div>
                            <div style="margin-bottom: 10px;">
                                <span class="answer-badge @(Model.ScreeningQ3HouseholdAgreement == "Yes" ? "answer-yes" : "answer-no")">
                                    @(string.IsNullOrWhiteSpace(Model.ScreeningQ3HouseholdAgreement) ? "Not Answered" : Model.ScreeningQ3HouseholdAgreement)
                                </span>
                            </div>
                            <div class="answer-text">
                                @(string.IsNullOrWhiteSpace(Model.ScreeningQ3Explanation) ? "No explanation provided" : Model.ScreeningQ3Explanation)
                            </div>
                        </div>

                        <div class="screening-question">
                            <div class="question-label">
                                <span class="question-number">4</span>
                                Relocation/Travel Contingency Plan
                            </div>
                            <div class="answer-text">
                                @(string.IsNullOrWhiteSpace(Model.ScreeningQ4RelocationPlan) ? "No answer provided" : Model.ScreeningQ4RelocationPlan)
                            </div>
                        </div>

                        <div class="screening-question">
                            <div class="question-label">
                                <span class="question-number">5</span>
                                Hours Pet Will Be Alone Daily
                            </div>
                            <div class="answer-text">
                                <strong>@(string.IsNullOrWhiteSpace(Model.ScreeningQ5HoursAlone) ? "Not specified" : Model.ScreeningQ5HoursAlone)</strong>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="section-title">Rejection Reason</div>
                    <div class="message-box" style="border-left-color: #ef4444; background: #fee2e2;">
                        @Model.RejectionReason
                    </div>
                }

                @if (Model.Status == "Approved" && !Model.IsReadyForPickup)
                {
                    <div class="pickup-box">
                        <h3><i class="fas fa-map-marker-alt"></i> Set Pickup Details for @Model.User.FullName</h3>

                        @using (Html.BeginForm("SetPickupDetails", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ApplicationId" />

                            <div class="form-group">
                                <label>Pickup Location *</label>
                                <input type="text" name="pickupLocation" placeholder="Enter exact address/location" required />
                            </div>

                            <div class="form-group">
                                <label>Pickup Date & Time *</label>
                                <input type="datetime-local" name="pickupDate" required />
                            </div>

                            <div class="form-group">
                                <label>Additional Notes</label>
                                <textarea name="pickupNotes" placeholder="Any special instructions for the adopter..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-pickup" style="width: 100%;">
                                <i class="fas fa-check-circle"></i> Notify Adopter - Set Pickup Details
                            </button>
                        }
                    </div>
                }

                @if (Model.IsReadyForPickup && Model.ClaimedDate == null)
                {
                    <div class="pickup-box" style="background: linear-gradient(135deg, #d1fae5 0%, #10b981 30%);">
                        <h3 style="color: #065f46;"><i class="fas fa-info-circle"></i> Pickup Details Set</h3>
                        <p style="color: #065f46; margin-bottom: 15px;">
                            <strong>Location:</strong> @Model.PickupLocation<br>
                            <strong>Date:</strong> @Model.PickupDate?.ToString("MMMM dd, yyyy hh:mm tt")<br>
                            @if (!string.IsNullOrEmpty(Model.PickupNotes))
                            {
                                <strong>Notes:</strong> @Model.PickupNotes
                            }
                        </p>

                        @using (Html.BeginForm("ConfirmTurnover", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-turnover" style="width: 100%;" onclick="return confirm('Confirm that @Model.Pet.Name has been turned over to @Model.User.FullName?')">
                                <i class="fas fa-handshake"></i> Confirm Turnover - Pet Claimed!
                            </button>
                        }
                    </div>
                }

                @if (Model.ClaimedDate != null)
                {
                    <div class="pickup-box" style="background: linear-gradient(135deg, #dbeafe 0%, #3b82f6 30%);">
                        <h3 style="color: #1e40af;"><i class="fas fa-check-circle"></i> Adoption Completed!</h3>
                        <p style="color: #1e40af;">
                            <strong>Pet Claimed On:</strong> @Model.ClaimedDate?.ToString("MMMM dd, yyyy hh:mm tt")<br>
                            @Model.Pet.Name has been successfully adopted by @Model.User.FullName! 🎉
                        </p>
                    </div>
                }

                @if (Model.Status == "Pending")
                {
                    <div class="action-buttons">
                        <a href="@Url.Action("Applications", "Admin")" class="btn btn-back">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>

                        <button type="button" class="btn btn-reject" onclick="showRejectModal()">
                            <i class="fas fa-times"></i> Reject Application
                        </button>

                        <button type="button" class="btn btn-approve" onclick="showApprovalModal()">
                            <i class="fas fa-check"></i> Approve Application
                        </button>
                    </div>
                }
                else
                {
                    <div class="action-buttons">
                        <a href="@Url.Action("Applications", "Admin")" class="btn btn-back" style="flex: none;">
                            <i class="fas fa-arrow-left"></i> Back to Applications
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Rejection Modal -->
    <div id="rejectModal" class="rejection-modal">
        <div class="modal-content">
            <h3><i class="fas fa-exclamation-circle"></i> Reject Application</h3>
            <p style="color: #64748b; margin-bottom: 20px;">Please provide a reason for rejection (consider screening answers):</p>

            @using (Html.BeginForm("RejectApplication", "Admin", FormMethod.Post, new { id = "rejectForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ApplicationId" />
                <textarea name="rejectionReason" placeholder="Enter reason for rejection..." required></textarea>

                <div class="modal-buttons">
                    <button type="button" class="btn btn-back" onclick="hideRejectModal()">Cancel</button>
                    <button type="submit" class="btn btn-reject">Reject with Reason</button>
                </div>
            }
        </div>
    </div>

    <!-- ⭐ NEW: Approval Confirmation Modal -->
    <div id="approvalModal" class="rejection-modal">
        <div class="modal-content" style="max-width: 600px;">
            <div style="text-align: center; margin-bottom: 20px;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #d1fae5 0%, #10b981 30%); margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-check-circle" style="font-size: 3em; color: #10b981;"></i>
                </div>
                <h3 style="color: #10b981; font-size: 1.8em; margin-bottom: 10px;">
                    Approve This Application?
                </h3>
            </div>

            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                    <img src="@(string.IsNullOrEmpty(Model.Pet.ImageUrl) ? "https://via.placeholder.com/60" : Model.Pet.ImageUrl)"
                         style="width: 60px; height: 60px; border-radius: 12px; object-fit: cover;">
                    <div>
                        <div style="font-weight: 700; color: #2E8BC0; font-size: 1.2em;">@Model.Pet.Name</div>
                        <div style="color: #64748b; font-size: 0.9em;">@Model.Pet.Breed</div>
                    </div>
                </div>
                <div style="border-top: 2px solid #e2e8f0; padding-top: 15px;">
                    <div style="color: #334155; font-weight: 600; margin-bottom: 5px;">
                        <i class="fas fa-user"></i> Adopter: @Model.User.FullName
                    </div>
                    <div style="color: #64748b; font-size: 0.9em;">
                        <i class="fas fa-envelope"></i> @Model.User.Email
                    </div>
                </div>
            </div>

            <div style="background: #FFF9E6; padding: 15px; border-radius: 10px; border-left: 4px solid #FFD93D; margin-bottom: 20px;">
                <div style="color: #92400e; font-size: 0.9em; line-height: 1.6;">
                    <strong><i class="fas fa-info-circle"></i> By approving:</strong><br>
                    • The pet will be marked as adopted<br>
                    • User will receive approval notification<br>
                    • You can then set pickup details
                </div>
            </div>

            @using (Html.BeginForm("ApproveApplication", "Admin", FormMethod.Post, new { id = "approvalForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ApplicationId" />

                <div class="modal-buttons">
                    <button type="button" class="btn btn-back" onclick="hideApprovalModal()" style="flex: 1;">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-approve" style="flex: 2;">
                        <i class="fas fa-check-circle"></i> Yes, Approve Application
                    </button>
                </div>
            }
        </div>
    </div>

    <script>
        function showRejectModal() {
            document.getElementById('rejectModal').style.display = 'flex';
        }
        function hideRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        function showApprovalModal() {
            document.getElementById('approvalModal').style.display = 'flex';
        }
        function hideApprovalModal() {
            document.getElementById('approvalModal').style.display = 'none';
        }

        // Auto-append "-FurEverHome Team" signature
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('rejectForm').addEventListener('submit', function (e) {
                var textarea = this.querySelector('textarea[name="rejectionReason"]');
                var reason = textarea.value.trim();

                if (!reason.includes('-FurEverHome Team')) {
                    textarea.value = reason + ' -FurEverHome Team';
                }
            });
        });
    </script>
</body>
</html>