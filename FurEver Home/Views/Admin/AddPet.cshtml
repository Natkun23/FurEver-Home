@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = "Add Pet - FurEver Home Admin";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            padding: 30px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 2em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            color: #64748b;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 12px 16px;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 15px;
                transition: all 0.3s;
                outline: none;
                background: #f8fafc;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: #3FA9F5;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
                }

            .form-group textarea {
                min-height: 100px;
                resize: vertical;
            }

        .file-upload {
            border: 2px dashed #cbd5e1;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: #f8fafc;
            cursor: pointer;
            transition: all 0.3s;
        }

            .file-upload:hover {
                border-color: #3FA9F5;
                background: #eff6ff;
            }

            .file-upload input[type="file"] {
                display: none;
            }

        .file-upload-icon {
            font-size: 3em;
            color: #3FA9F5;
            margin-bottom: 15px;
        }

        .checkbox-group {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .checkbox-item input[type="checkbox"] {
                width: auto;
                cursor: pointer;
            }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-submit {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
            }

        .btn-cancel {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-paw"></i> Add New Pet</h1>
            <p class="page-subtitle">Fill in the details to add a new pet for adoption</p>
        </div>

        @using (Html.BeginForm("AddPet", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.Name, "Pet Name")
                    @Html.TextBoxFor(m => m.Name, new { placeholder = "Enter pet name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PetTypeId, "Pet Type")
                    @Html.DropDownListFor(m => m.PetTypeId,
                        new SelectList(ViewBag.PetTypes, "PetTypeId", "TypeName"),
                        "-- Select Type --",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.PetTypeId, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Breed)
                    @Html.TextBoxFor(m => m.Breed, new { placeholder = "Enter breed" })
                    @Html.ValidationMessageFor(m => m.Breed, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Age, "Age (years)")
                    @Html.TextBoxFor(m => m.Age, new { type = "number", min = "0", max = "20", placeholder = "Age" })
                    @Html.ValidationMessageFor(m => m.Age, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Gender)
                    @Html.DropDownListFor(m => m.Gender,
                        new SelectList(new[] { "Male", "Female" }),
                        "-- Select Gender --",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Size)
                    @Html.DropDownListFor(m => m.Size,
                        new SelectList(new[] { "Small", "Medium", "Large" }),
                        "-- Select Size --",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Size, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.DaysInCenter, "Days in Center")
                    @Html.TextBoxFor(m => m.DaysInCenter, new { type = "number", min = "0", placeholder = "0", Value = "0" })
                </div>
            </div>

            <div class="form-group full-width">
                @Html.LabelFor(m => m.Description)
                @Html.TextAreaFor(m => m.Description, new { placeholder = "Describe the pet's personality and story...", rows = "4" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group full-width">
                @Html.LabelFor(m => m.Traits, "Personality Traits (comma-separated)")
                @Html.TextBoxFor(m => m.Traits, new { placeholder = "e.g., Friendly, Playful, Gentle" })
                <small style="color: #64748b;">Separate traits with commas</small>
            </div>

            <div class="form-group full-width">
                @Html.LabelFor(m => m.Vaccines, "Vaccination Info")
                @Html.TextAreaFor(m => m.Vaccines, new { placeholder = "List all vaccines...", rows = "3" })
            </div>

            <div class="form-group full-width">
                @Html.LabelFor(m => m.WhyAdoptMe, "Why Adopt Me? (comma-separated)")
                @Html.TextAreaFor(m => m.WhyAdoptMe, new { placeholder = "e.g., Great with kids, Fully trained, Loves to play", rows = "3" })
                <small style="color: #64748b;">Separate reasons with commas</small>
            </div>

            <div class="form-group full-width">
                <label>Health Status</label>
                <div class="checkbox-group">
                    <div class="checkbox-item">
                        @Html.CheckBoxFor(m => m.IsHealthy, new { @checked = "checked" })
                        @Html.LabelFor(m => m.IsHealthy, "Healthy", new { style = "margin: 0; font-weight: normal;" })
                    </div>
                    <div class="checkbox-item">
                        @Html.CheckBoxFor(m => m.IsNeutered, new { @checked = "checked" })
                        @Html.LabelFor(m => m.IsNeutered, "Spayed/Neutered", new { style = "margin: 0; font-weight: normal;" })
                    </div>
                </div>
            </div>

            <div class="form-group full-width">
                <label>Pet Image</label>
                <div class="file-upload" onclick="document.getElementById('petImage').click()">
                    <div class="file-upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                    <div>Click to upload pet image</div>
                    <small style="color: #64748b;">PNG, JPG (Max 5MB)</small>
                    <input type="file" id="petImage" name="PetImage" accept="image/*">
                    <div id="fileName" style="margin-top: 12px; color: #3FA9F5; font-weight: 600;"></div>
                </div>
            </div>

            <div class="action-buttons">
                <a href="@Url.Action("Pets", "Admin")" class="btn btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn btn-submit">
                    <i class="fas fa-check"></i> Add Pet
                </button>
            </div>
        }
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('petImage').addEventListener('change', function(e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('fileName').textContent = '✓ ' + fileName;
            }
        });
    </script>
</body>
</html>