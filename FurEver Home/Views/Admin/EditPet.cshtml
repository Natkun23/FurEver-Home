@model FurEver_Home.Models.Pet
@{
    ViewBag.Title = "Edit Pet - FurEver Home Admin";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/Content/Images/circle_furever.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            padding: 30px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 2em;
            color: #2E8BC0;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            color: #64748b;
        }

        .org-info-box {
            background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
            border-left: 4px solid #3FA9F5;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

            .org-info-box h4 {
                color: #1e40af;
                margin-bottom: 10px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 1.1em;
            }

        .org-name-field {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fbbf24 100%);
            border: 3px solid #f59e0b;
            padding: 25px;
            border-radius: 16px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);
            position: relative;
            overflow: hidden;
        }

            .org-name-field::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -50%;
                width: 200px;
                height: 200px;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 50%;
            }

            .org-name-field::after {
                content: '';
                position: absolute;
                bottom: -30%;
                left: -20%;
                width: 150px;
                height: 150px;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 50%;
            }

            .org-name-field label {
                color: #78350f;
                font-size: 1.1em;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 15px;
                position: relative;
                z-index: 1;
            }

                .org-name-field label i {
                    font-size: 1.3em;
                    color: #f59e0b;
                }

            .org-name-field input {
                background: white;
                border: 2px solid #f59e0b;
                position: relative;
                z-index: 1;
                font-weight: 600;
                color: #92400e;
            }

                .org-name-field input:focus {
                    border-color: #d97706;
                    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.2);
                }

            .org-name-field small {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #78350f;
                margin-top: 12px;
                font-size: 0.95em;
                font-weight: 600;
                position: relative;
                z-index: 1;
            }

                .org-name-field small i {
                    color: #f59e0b;
                    font-size: 1.1em;
                }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                color: #334155;
                margin-bottom: 8px;
                font-weight: 600;
                font-size: 14px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 12px 16px;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 15px;
                transition: all 0.3s;
                outline: none;
                background: #f8fafc;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: #3FA9F5;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.1);
                }

            .form-group textarea {
                min-height: 100px;
                resize: vertical;
            }

        /* ✅ Updated: Modern Thumbnail with Hover Effect */
        .image-preview-section {
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            text-align: center;
        }

            .image-preview-section h4 {
                color: #334155;
                margin-bottom: 15px;
                font-size: 1em;
                font-weight: 700;
            }

        .pet-image-thumbnail-wrapper {
            position: relative;
            max-width: 300px;
            width: 100%;
            margin: 0 auto 20px;
            cursor: pointer;
            border-radius: 15px;
            overflow: hidden;
            border: 3px solid #3FA9F5;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .current-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .image-hover-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.6) 70%, transparent 100%);
            color: white;
            padding: 20px;
            transform: translateY(100%);
            transition: transform 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            font-size: 15px;
        }

        .pet-image-thumbnail-wrapper:hover .image-hover-overlay {
            transform: translateY(0);
        }

        .pet-image-thumbnail-wrapper:hover .current-image {
            transform: scale(1.05);
        }

        .image-label {
            display: block;
            color: #64748b;
            font-size: 0.9em;
            font-weight: 600;
        }

        .file-upload {
            border: 2px dashed #cbd5e1;
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
        }

            .file-upload:hover {
                border-color: #3FA9F5;
                background: #eff6ff;
            }

            .file-upload input[type="file"] {
                display: none;
            }

        .file-upload-icon {
            font-size: 3em;
            color: #3FA9F5;
            margin-bottom: 15px;
        }

        .checkbox-group {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .checkbox-item input[type="checkbox"] {
                width: auto;
                cursor: pointer;
            }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-submit {
            background: linear-gradient(135deg, #FFD93D 0%, #F6C90E 100%);
            color: #2E8BC0;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 217, 61, 0.4);
            }

        .btn-cancel {
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 13px;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-edit"></i> Edit Pet: @Model.Name</h1>
            <p class="page-subtitle">Update pet information for adoption</p>
        </div>

        <div class="org-info-box">
            <h4>
                <i class="fas fa-building"></i>
                Organization Information
            </h4>
            <p>
                <strong>Current Status:</strong>
                @if (Model.PostedByType == "Organization" && !string.IsNullOrEmpty(Model.OrganizationName))
                {
                    <span style="color: #3FA9F5;">Posted by Organization: <strong>@Model.OrganizationName</strong></span>
                }
                else
                {
                    <span style="color: #64748b;">Posted by FurEver Home Admin</span>
                }
            </p>
        </div>

        @using (Html.BeginForm("EditPet", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.PetId)

            <!-- Organization Name Field -->
            <div class="org-name-field">
                <label>
                    <i class="fas fa-building"></i>
                    Organization Name (Optional)
                </label>
                @Html.TextBoxFor(m => m.OrganizationName, new
                {
                    placeholder = "e.g., Quezon City Dog Welfare, PAWS, Animal Kingdom Foundation",
                    maxlength = "255",
                    @class = "form-control"
                })
                <small>
                    <i class="fas fa-info-circle"></i>
                    Update organization name or leave blank for "FurEver Home Admin"
                </small>
            </div>

            <!-- ✅ Updated: Current Image Preview with Hover Effect -->
            if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="image-preview-section">
                    <h4><i class="fas fa-image"></i> Current Pet Image</h4>
                    <div class="pet-image-thumbnail-wrapper" onclick="document.getElementById('petImage').click()">
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="current-image" />
                        <div class="image-hover-overlay">
                            <i class="fas fa-camera"></i>
                            <span>Change Pet Photo</span>
                        </div>
                    </div>
                    <span class="image-label">Click image to change</span>
                </div>
            }
            else
            {
                <div class="form-group full-width">
                    <label>Pet Image</label>
                    <div class="file-upload" onclick="document.getElementById('petImage').click()">
                        <div class="file-upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                        <div>Click to upload pet image</div>
                        <small style="color: #64748b;">PNG, JPG (Max 5MB)</small>
                    </div>
                </div>
            }

            <!-- Hidden file input -->
            <input type="file" id="petImage" name="PetImage" accept="image/*" style="display: none;">
            <div id="fileName" style="margin-bottom: 20px; text-align: center; color: #3FA9F5; font-weight: 600;"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Pet Name *</label>
                    @Html.TextBoxFor(m => m.Name, new { placeholder = "Enter pet's name", required = "required" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    <label>Pet Type *</label>
                    @Html.DropDownListFor(m => m.PetTypeId,
                        new SelectList(ViewBag.PetTypes, "PetTypeId", "TypeName", Model.PetTypeId),
                        "-- Select Type --",
                        new { required = "required" })
                </div>

                <div class="form-group">
                    <label>Breed *</label>
                    @Html.TextBoxFor(m => m.Breed, new { placeholder = "Enter breed", required = "required" })
                </div>

                <div class="form-group">
                    <label>Age *</label>
                    @Html.TextBoxFor(m => m.Age, new { type = "number", min = "0", max = "20", required = "required" })
                </div>

                <div class="form-group">
                    <label>Age Unit *</label>
                    @Html.DropDownListFor(m => m.AgeUnit,
                        new SelectList(new[] { "Months", "Years" }, Model.AgeUnit),
                        new { required = "required" })
                </div>

                <div class="form-group">
                    <label>Gender *</label>
                    @Html.DropDownListFor(m => m.Gender,
                        new SelectList(new[] { "Male", "Female" }, Model.Gender),
                        "-- Select Gender --",
                        new { required = "required" })
                </div>

                <div class="form-group">
                    <label>Size *</label>
                    @Html.DropDownListFor(m => m.Size,
                        new SelectList(new[] { "Small", "Medium", "Large" }, Model.Size),
                        "-- Select Size --",
                        new { required = "required" })
                </div>

                <div class="form-group">
                    <label>Days in Center</label>
                    @Html.TextBoxFor(m => m.DaysInCenter, new { type = "number", min = "0" })
                </div>
            </div>

            <div class="form-group full-width">
                <label>Description *</label>
                @Html.TextAreaFor(m => m.Description, new { placeholder = "Describe the pet's personality and story...", rows = "4", required = "required" })
            </div>

            <div class="form-group full-width">
                <label>Personality Traits (comma-separated)</label>
                @Html.TextBoxFor(m => m.Traits, new { placeholder = "e.g., Friendly, Playful, Gentle" })
                <small style="color: #64748b;">Separate traits with commas</small>
            </div>

            <div class="form-group full-width">
                <label>Vaccination Info</label>
                @Html.TextAreaFor(m => m.Vaccines, new { placeholder = "List all vaccines...", rows = "3" })
            </div>

            <div class="form-group full-width">
                <label>Why Adopt Me? (comma-separated)</label>
                @Html.TextAreaFor(m => m.WhyAdoptMe, new { placeholder = "e.g., Great with kids, Fully trained", rows = "3" })
            </div>

            <div class="form-group full-width">
                <label>Health Status</label>
                <div class="checkbox-group">
                    <div class="checkbox-item">
                        @Html.CheckBoxFor(m => m.IsHealthy)
                        @Html.LabelFor(m => m.IsHealthy, "Healthy", new { style = "margin: 0; font-weight: normal;" })
                    </div>
                    <div class="checkbox-item">
                        @Html.CheckBoxFor(m => m.IsNeutered)
                        @Html.LabelFor(m => m.IsNeutered, "Spayed/Neutered", new { style = "margin: 0; font-weight: normal;" })
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <a href="@Url.Action("Pets", "Admin")" class="btn btn-cancel">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn btn-submit">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        }
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script>
        document.getElementById('petImage').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                document.getElementById('fileName').textContent = '✓ New image selected: ' + fileName;
            }
        });
    </script>
</body>
</html>