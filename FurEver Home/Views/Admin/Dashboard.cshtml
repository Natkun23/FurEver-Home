    }

    // Periodic re-lock every 30 seconds for extra security
    setInterval(function() {
        if (navigationLocked && !isRedirecting) {
            lockNavigation();
        }
    }, 30000);

    // Catch unhandled navigation attempts
    window.addEventListener('beforeunload', function(e) {
        // Don't prevent, just track
        if (navigationLocked && !isRedirecting && !lockingEnabled) {
            isRedirecting = true;
        }
    });

    // Final fallback - message channel for iframe security
    if (window.opener) {
        window.opener = null; // Prevent window.opener manipulation
    }

    // Log initial state
    console.log('🔒 Dashboard: Back button protection ACTIVE');
    console.log('🔐 Navigation locked: ' + navigationLocked);
    console.log('📌 History stack size: 10+ layers');

})();

