<script>
(function(){
    'use strict';
    const modal = document.getElementById('logoutConfirmModal');
    const btnCancel = document.getElementById('logoutCancelBtn');
    const btnConfirm = document.getElementById('logoutConfirmBtn');

    function showLogoutModal(href) {
        modal.style.display = 'flex';
        modal.setAttribute('data-logout-href', href);
        modal.classList.add('show');
        // Set focus to cancel button for accessibility
        setTimeout(() => {
            btnCancel.focus();
        }, 100);
    }

    function hideLogoutModal() {
        modal.classList.remove('show');
        setTimeout(() => {
            modal.style.display = 'none';
            modal.removeAttribute('data-logout-href');
        }, 300);
    }

    // Intercept clicks on logout anchors
    document.addEventListener('click', function(e){
        const a = e.target.closest('a');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        if (/logout/i.test(href)) {
            e.preventDefault();
            showLogoutModal(href);
        }
    }, true);

    // Cancel button
    btnCancel.addEventListener('click', function(){
        hideLogoutModal();
    });

    // Confirm logout button
    btnConfirm.addEventListener('click', function(){
        const href = modal.getAttribute('data-logout-href');
        if (!href) return;

        // Disable button during logout to prevent double-clicks
        btnConfirm.disabled = true;
        btnConfirm.style.opacity = '0.6';
        btnConfirm.style.cursor = 'not-allowed';

        // Create a temporary anchor with data-action=logout so existing handlers allow navigation
        const temp = document.createElement('a');
        temp.href = href;
        temp.setAttribute('data-action', 'logout');
        temp.style.display = 'none';
        document.body.appendChild(temp);

        // Dispatch a click to trigger existing capture-phase handlers that call allowNavigation()
        temp.click();

        // As a fallback, force navigation after a short delay
        setTimeout(function(){
            if (document.location.href !== href) {
                window.location.href = href;
            }
        }, 300);
    });

    // Close modal on Escape key
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape' && modal.style.display === 'flex') {
            hideLogoutModal();
        }
    });

    // Close modal when clicking outside (on backdrop)
    modal.addEventListener('click', function(e){
        if (e.target === modal) {
            hideLogoutModal();
        }
    });
})();
</script>